+/* [SELFTEST] Per-screen LVGL heap snapshot (grep "[MEM]" on the UART): verifies the trimmed 44K pool survives the heavy screens (scanner/GATT detail). */
+static void badge_dbg_lvmem(const char *tag)
+{
+    lv_mem_monitor_t m;
+    lv_mem_monitor(&m);
+    printf("[MEM] %-8s used=%u%% free=%uB max_used=%uB biggest_free=%uB frag=%u%%\n",
+           tag, m.used_pct, (unsigned)m.free_size, (unsigned)m.max_used,
+           (unsigned)m.free_biggest_size, m.frag_pct);
+}
