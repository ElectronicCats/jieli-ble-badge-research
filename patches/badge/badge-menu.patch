+/* ---- BLE-updatable lock wallpaper (fixed flash slot, no reflash) --------------
+ * The lock image can be replaced over BLE — no firmware reflash — by raw-flashing an image
+ * blob to a fixed flash slot: `qix rawflash <mac> lockimg.bin --addr 0x300000 --verify --reboot`.
+ * The slot 0x300000 sits ABOVE the OTA staging band (0x17E000..~0x27E000), so a firmware OTA
+ * does NOT erase it; it's within the raw-flash-writable region [0x17E000,0x3BE000).
+ * Blob layout: [lock_img_hdr_t (16B)] [w*h*2 bytes RGB565].
+ * The slot is read with tzflash_read (the same API used by the raw-flash service and the board's own
+ * in-flash image splash) — NOT via an XIP pointer: on this part only the CODE region (<0x17E000)
+ * is reliably memory-mapped, so a pointer to 0x300000 could fault (the board reads its 0x200000 splash
+ * the same way). The 16B header is validated first; on any mismatch — or if the read fails
+ * — we fall back to the firmware-embedded default (lock_wallpaper, badge_4). The pixels are copied
+ * to a static RAM buffer, so the slot image is capped at LOCK_IMG_MAX (144x144, same as the
+ * embedded default) to keep the buffer bounded. Send with --reboot so the badge re-reads the slot. */
+#define LOCK_IMG_SLOT_OFF   0x300000u
+#define LOCK_IMG_MAGIC      0x474D4B4Cu   /* "LKMG" */
+#define LOCK_IMG_MAX_W      144
+#define LOCK_IMG_MAX_H      144
+
+typedef struct {
+    u32 magic;      /* LOCK_IMG_MAGIC */
+    u16 w, h;       /* pixel dimensions */
+    u32 size;       /* == w*h*2 */
+    u32 rsv;
+} lock_img_hdr_t;   /* 16 bytes, immediately followed by the RGB565 pixels */
+
+static u8 g_lock_img_buf[LOCK_IMG_MAX_W * LOCK_IMG_MAX_H * 2] __attribute__((aligned(4)));
+
+/* Returns the wallpaper to show on the lock screen: the BLE-pushed slot image if the slot has a
+ * valid header and fits the buffer, else the firmware-embedded default. Fills a static dsc. */
+static const lv_img_dsc_t *lock_img_resolve(void)
+{
+    extern int tzflash_read(void *buf, u32 len, u32 offset);
+    static lv_img_dsc_t slot_dsc;
+    lock_img_hdr_t h;
+    if (tzflash_read(&h, sizeof(h), LOCK_IMG_SLOT_OFF) >= 0 &&
+        h.magic == LOCK_IMG_MAGIC &&
+        h.w >= 16 && h.w <= LOCK_IMG_MAX_W && h.h >= 16 && h.h <= LOCK_IMG_MAX_H &&
+        h.size == (u32)h.w * h.h * 2 &&
+        tzflash_read(g_lock_img_buf, h.size, LOCK_IMG_SLOT_OFF + sizeof(lock_img_hdr_t)) >= 0) {
+        slot_dsc.header.always_zero = 0;
+        slot_dsc.header.w  = h.w;
+        slot_dsc.header.h  = h.h;
+        slot_dsc.header.cf = LV_IMG_CF_TRUE_COLOR;
+        slot_dsc.data_size = h.size;
+        slot_dsc.data = g_lock_img_buf;
+        printf("lock img: slot %ux%u loaded from 0x%x\n", h.w, h.h, LOCK_IMG_SLOT_OFF);
+        return &slot_dsc;
+    }
+    printf("lock img: no valid slot image, using embedded default\n");
+    return &lock_wallpaper;
+}
+
+/* ---- Lock / screensaver: display + touch OFF, CPU running; a hardware key wakes ----
+ * Boot enters this state; the menu's "Lock" button returns to it. While locked the main
+ * loop skips LVGL and only polls the ADKEY value g_badge_adkey_kv (kept fresh by the key-scan
+ * system timer regardless of display/touch state). Waking shows the lock image; a swipe there
+ * opens the menu. The panel is fully powered down (LCD_POWER_DOWN_EN=1 on this badge), so waking
+ * needs a full re-init via lcd_reinit_wait_finish(). Heavy LCD ops run from the main loop
+ * (not inside an LVGL event callback) — the menu button only sets g_badge_lock_req. */
+static void badge_lock_enter(void)
+{
+    extern int lcd_sleep_ctrl(u8 enter);
+    extern void badge_touch_set_enable(u8 en);
+    printf("lock: enter (display+touch off)\n");
+    g_badge_locked = 1;
+    if (g_kp_group) { lv_group_remove_all_objs(g_kp_group); }  /* keys do nothing on the lock image */
+    lv_scr_load(g_lock_scr);      /* parks on the image screen (not drawn — the panel goes to sleep) */
+    badge_touch_set_enable(0);    /* stops touch polling (power saving) */
+    lcd_sleep_ctrl(1);            /* backlight 0 + panel to sleep + power down */
+}
+
+static void badge_lock_wake(void)
+{
+    extern int lcd_sleep_ctrl(u8 enter);
+    extern void lcd_reinit_wait_finish(void);
+    extern int lcd_drv_backlight_ctrl(u8 percent);
+    extern void badge_touch_set_enable(u8 en);
+    printf("lock: wake -> image\n");
+    lcd_sleep_ctrl(0);            /* powers the panel back on (kicks off the re-init task) */
+    lcd_reinit_wait_finish();     /* blocks until the panel re-init finishes */
+    lcd_drv_backlight_ctrl(g_bright_pct[g_bright_idx]);   /* backlight back to the saved brightness */
+    badge_touch_set_enable(1);    /* resumes touch (re-inits the AXS5106L; see board file) */
+    g_badge_locked = 0;           /* the main loop resumes -> renders the lock image */
+    lv_obj_invalidate(g_lock_scr);/* forces a full redraw */
+}
