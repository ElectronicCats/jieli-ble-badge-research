diff --git a/SDK/tools/check_custom_fw.py b/SDK/tools/check_custom_fw.py
new file mode 100644
index 0000000..eed8d99
--- /dev/null
+++ b/SDK/tools/check_custom_fw.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+r"""
+check_custom_fw.py — validate a custom badge firmware against the rules that
+make it (a) BLE-loadable and (b) able to boot/run on the badge.
+
+Runs automatically at the end of `make STAGER=1 ...` (wired into the root
+Makefile), or by hand:  python tools/check_custom_fw.py cpu/br35/tools/app.bin --stager [--menu]
+
+Exit 0 = OK, exit 1 = a hard rule is violated (the firmware wouldn't load or would hang).
+
+================================ THE RULES ================================
+R1  CODE SIZE  (hard)  app.bin <= 995616 B.
+        This is the app image size budget for a BLE OTA. Nothing bigger can be
+        flashed over BLE (USB only). Keep the big assets (images, fonts) as
+        raw-flashed *content*, not compiled into app.bin.
+
+R2  RE-FLASHABLE (hard)  build with STAGER=1.
+        Keeps the 0xD0-0xD4 raw-flash service + lcflash-apply so the firmware
+        stays BLE-re-flashable. Without it, the only way back is USB.
+
+R3  TOUCH      (hard, UI builds)  AXS5106L, NOT CST816D.
+        The badge has the AXS5106L on bit-banged I2C (PB1/PB2). If an LVGL/UI
+        touch path uses the CST816D driver on the iic0 hardware, it floods
+        "iic0 isr sta:-8" and HANGS (there's no CST816D chip). In a UI build,
+        TCFG_TP_CST816D_ENABLE must be 0 and an AXS5106L get_touch_x_y_status()
+        must be provided.
+
+R4  RESOURCES  (manual)  no dependency on the ~4 MB watch UI resource set.
+        It won't fit in the 4 MB flash. The UI must be drawn by code (LVGL's
+        built-in font) or load only raw-flashed content.
+==========================================================================
+"""
+import argparse
+import os
+import re
+import sys
+
+MAX_APP = 995616  # app image size budget for BLE-OTA; see R1
+
+
+def cst816d_enabled(sdk_dir: str) -> bool:
+    """True if the CST816D touch driver is compiled in for this board."""
+    cfg = os.path.join(sdk_dir, "apps/watch/board/br35/board_ac707n_demo/"
+                                "board_ac707n_demo_cfg.h")
+    try:
+        txt = open(cfg, encoding="utf-8", errors="replace").read()
+    except OSError:
+        return False
+    # Take the LAST #define (the effective one): a CONFIG_BADGE_MENU build #undefs the
+    # base value and redefines it to 0, so the last occurrence is what the menu build uses.
+    vals = re.findall(r"#define\s+TCFG_TP_CST816D_ENABLE\s+(\d+)", txt)
+    return bool(vals and vals[-1] != "0")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="custom-firmware rule checker")
+    ap.add_argument("app_bin", nargs="?", default="cpu/br35/tools/app.bin")
+    ap.add_argument("--sdk", default=".", help="SDK root (for config checks)")
+    ap.add_argument("--stager", action="store_true", help="build had STAGER=1")
+    ap.add_argument("--menu", action="store_true",
+                    help="build had MENU=1 (LVGL UI active -> check touch)")
+    args = ap.parse_args()
+
+    fails, warns, oks = [], [], []
+
+    # R1 — code size
+    if not os.path.exists(args.app_bin):
+        fails.append(f"R1: app.bin not found ({args.app_bin})")
+    else:
+        sz = os.path.getsize(args.app_bin)
+        if sz > MAX_APP:
+            fails.append(f"R1 SIZE: app.bin {sz} > {MAX_APP} (over by {sz - MAX_APP}). "
+                         f"Not BLE-loadable — move big assets to raw-flash content.")
+        else:
+            oks.append(f"R1 size: {sz} <= {MAX_APP} ({MAX_APP - sz} B headroom)")
+
+    # R2 — stager service
+    if args.stager:
+        oks.append("R2 stager: CONFIG_STAGER on (stays BLE-re-flashable)")
+    else:
+        fails.append("R2 STAGER: built without STAGER=1 — no 0xD4 loader, only USB recovery.")
+
+    # R3 — touch (only relevant for a UI/touch build)
+    if args.menu:
+        if cst816d_enabled(args.sdk):
+            fails.append("R3 TOUCH: TCFG_TP_CST816D_ENABLE is ON with an LVGL UI active. "
+                         "The badge has AXS5106L; CST816D floods iic0 and HANGS. Disable "
+                         "CST816D and provide an AXS5106L get_touch_x_y_status().")
+        else:
+            oks.append("R3 touch: CST816D off (AXS5106L expected)")
+    else:
+        oks.append("R3 touch: n/a (no UI build)")
+
+    print("=== custom firmware rule check ===")
+    for o in oks:
+        print(f"  OK   {o}")
+    for w in warns:
+        print(f"  WARN {w}")
+    for f in fails:
+        print(f"  FAIL {f}")
+    if fails:
+        print(">>> FAILED - fix the rules above before deploying.")
+        return 1
+    print(">>> PASS - BLE-stager-loadable.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
