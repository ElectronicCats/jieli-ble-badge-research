+static void get_ble_name_from_adv(const u8 *data, u8 data_len, char *name_buf, int max_buf_len)
+{
+    name_buf[0] = '\0';
+    for (u8 i = 0; i < data_len; ) {
+        u8 length = data[i];
+        if (length == 0 || (i + 1 + length) > data_len) {
+            break;
+        }
+        u8 ad_type = data[i + 1];
+        if (ad_type == 0x09 || ad_type == 0x08) { // Complete or shortened local name
+            int name_len = length - 1;
+            if (name_len > max_buf_len - 1) {
+                name_len = max_buf_len - 1;
+            }
+            if (name_len > 0) {
+                memcpy(name_buf, &data[i + 2], name_len);
+                name_buf[name_len] = '\0';
+                return;
+            }
+        }
+        i += 1 + length;
+    }
+}
+
+/* Dedup/shared storage for BOTH BLE advertising reports and classic BR/EDR inquiry results.
+ * Runs in BT task context (the HCI handler / the inquiry callback), not in lvgl_main_task, so
+ * it takes the lock itself. Exported (non-static) so the classic-inquiry glue in bt.c can also feed results
+ * here. Dedup is by MAC across both transports; the weakest RSSI is evicted when full. */
+void badge_scanner_add_device(const u8 *addr, const char *name, s8 rssi, u8 type,
+                              const u8 *adv_data, u8 adv_len, u8 addr_type)
+{
+    if (!g_scanner_active) {
+        return;
+    }
+    if (adv_len > sizeof(g_scanner_devs[0].adv_data)) {
+        adv_len = sizeof(g_scanner_devs[0].adv_data);
+    }
+    OS_SR_ALLOC();
+    OS_ENTER_CRITICAL();
+
+    int index = -1;
+    for (int i = 0; i < g_scanner_dev_count; i++) {
+        if (memcmp(g_scanner_devs[i].address, addr, 6) == 0) {
+            index = i;
+            break;
+        }
+    }
+
+    if (index != -1) {
+        /* Already listed: quietly refresh RSSI/type/adv. Do NOT trigger a list redraw on every
+         * repeated advertisement -- the user wants the list to only add NEW discoveries, no movement.
+         * The only exception is a name that finally resolves (Unknown -> real name). */
+        g_scanner_devs[index].rssi = rssi;
+        g_scanner_devs[index].type = type;
+        g_scanner_devs[index].addr_type = addr_type;
+        if (adv_data && adv_len) {
+            memcpy(g_scanner_devs[index].adv_data, adv_data, adv_len);
+            g_scanner_devs[index].adv_len = adv_len;
+        }
+        if (strcmp(g_scanner_devs[index].name, "Unknown") == 0 && strcmp(name, "Unknown") != 0) {
+            strncpy(g_scanner_devs[index].name, name, sizeof(g_scanner_devs[index].name) - 1);
+            g_scanner_list_needs_update = 1;
+        }
+    } else {
+        int slot = -1;
+        if (g_scanner_dev_count < SCANNER_MAX_DEVS) {
+            slot = g_scanner_dev_count++;
+        } else {
+            int lowest_idx = 0;
+            for (int i = 1; i < SCANNER_MAX_DEVS; i++) {
+                if (g_scanner_devs[i].rssi < g_scanner_devs[lowest_idx].rssi) {
+                    lowest_idx = i;
+                }
+            }
+            if (rssi > g_scanner_devs[lowest_idx].rssi) {
+                slot = lowest_idx;
+            }
+        }
+        if (slot != -1) {
+            memset(&g_scanner_devs[slot], 0, sizeof(g_scanner_devs[slot]));
+            memcpy(g_scanner_devs[slot].address, addr, 6);
+            strncpy(g_scanner_devs[slot].name, name, sizeof(g_scanner_devs[slot].name) - 1);
+            g_scanner_devs[slot].rssi = rssi;
+            g_scanner_devs[slot].is_new = 1;
+            g_scanner_devs[slot].type = type;
+            g_scanner_devs[slot].addr_type = addr_type;
+            if (adv_data && adv_len) {
+                memcpy(g_scanner_devs[slot].adv_data, adv_data, adv_len);
+                g_scanner_devs[slot].adv_len = adv_len;
+            }
+            g_scanner_list_needs_update = 1;
+        }
+    }
+
+    OS_EXIT_CRITICAL();
+}
+
+static void process_scan_report(const u8 *packet, u16 size)
+{
+    (void)size;
+    if (!g_scanner_active) {
+        return;
+    }
+    adv_report_t *report = (adv_report_t *)&packet[2];
+    char name[32];
+    get_ble_name_from_adv(report->data, report->length, name, sizeof(name));
+    if (name[0] == '\0') {
+        strcpy(name, "Unknown");
+    }
+    badge_scanner_add_device(report->address, name, report->rssi, SCANNER_TYPE_BLE,
+                             report->data, report->length, report->address_type);
+    /* Reference-style connect: fires create_connection synced to the target's fresh adv. */
+    extern void badge_gatt_on_adv(const u8 *addr, u8 addr_type);
+    badge_gatt_on_adv(report->address, report->address_type);
+}
+
+/* adv-report sink, called from ble_rcsp_server.c::cbk_packet_handler (this firmware's active
+ * HCI handler) for every event. We only consume GAP advertising reports (0xE2)
+ * while the Scanner screen is open. Hooking the existing handler avoids changing the
+ * global — the multi-role handler the old swap relied on is compiled out (#if 0)
+ * in this RCSP server build. */
+void badge_scanner_on_hci(uint8_t packet_type, uint8_t *packet, uint16_t size)
+{
+    if (!g_scanner_active) {
+        return;
+    }
+    /* DIAG (remove later): traces whether this hook fires and whether adv reports (0xE2) arrive while scanning. */
+    static u16 hci_n = 0, adv_n = 0;
+    hci_n++;
+    if (packet_type == HCI_EVENT_PACKET && packet[0] == 0xE2) { // GAP_EVENT_ADVERTISING_REPORT
+        adv_n++;
+        if (adv_n <= 3 || (adv_n % 25) == 0) {
+            printf("scanner: adv report #%u (hci seen=%u)\n", adv_n, hci_n);
+        }
+        process_scan_report(packet, size);
+    } else if (hci_n <= 10) {
+        printf("scanner: hci type=%u code=0x%02x\n", packet_type, packet[0]);
+    }
+}
+
+/* The Scanner is BLE-only: the LE scan runs continuously. (Classic BR/EDR inquiry is not used here
+ * -- in this firmware's receiver mode the inquiry command only runs with the full A2DP-source
+ * "sender mode", which would reintroduce audio profiles and put the HID mouse at risk; and nRF-Connect-style
+ * browsing is a BLE concept anyway. The classic glue in bt.c stays idle, unused.) */
+
+static void scanner_screen_open(void)
+{
+    printf("scanner: enter (BLE scan)%s\n", g_scanner_spoof_intent ? " [spoof: tap to clone]" : "");
+    g_ble_want_on = 1;
+    ble_on();
+    /* A scanner is just an OBSERVER — stop our own advertising so the radio is free to scan
+     * (advertising as a peripheral can starve the LE scan). */
+    extern void rcsp_bt_ble_adv_enable(u8 enable);
+    rcsp_bt_ble_adv_enable(0);
+
+    OS_SR_ALLOC();
+    OS_ENTER_CRITICAL();
+    g_scanner_dev_count = 0;
+    g_scanner_list_needs_update = 0;
+    memset(g_scanner_devs, 0, sizeof(g_scanner_devs));
+    OS_EXIT_CRITICAL();
+
+    for (int i = 0; i < SCANNER_MAX_DEVS; i++) {
+        lv_obj_add_flag(g_scanner_btns[i], LV_OBJ_FLAG_HIDDEN);
+    }
+
+    g_scanner_active = 1;
+
+    /* Continuous active LE scan, duplicate filtering OFF. The adv reports (0xE2) arrive via
+     * badge_scanner_on_hci -> process_scan_report -> badge_scanner_add_device. */
+    int sp = ble_op_set_scan_param(1, 160, 160);   /* active scan, interval/window 100 ms */
+    int se = ble_op_scan_enable2(1, 0);
+    printf("scanner: scan_param=%d scan_enable=%d (0=ok, !=0 rejected)\n", sp, se);
+
+    lv_scr_load(g_scanner_scr);
+    kp_set_one(g_scanner_keytgt);   /* Button 1 = back */
+    badge_dbg_lvmem("scanner");
+}
+/* Same device-list screen, two entry points: "Scanner Bluetooth" browses GATT, "Spoofing
+ * Bluetooth" clones the tapped device. The intent flag steers scanner_item_cb. */
+static void scanner_open_cb(lv_event_t *e) { (void)e; g_scanner_spoof_intent = 0; scanner_screen_open(); }
+static void spoof_open_cb(lv_event_t *e)   { (void)e; g_scanner_spoof_intent = 1; scanner_screen_open(); }
+
+static void scanner_back_cb(lv_event_t *e)
+{
+    (void)e;
+    printf("scanner: exit (BLE off)\n");
+    g_scanner_active = 0;
+
+    ble_op_scan_enable(0);   /* the hooks ignore reports once g_scanner_active is 0 */
+
+    /* Leaving the Spoofing/Scanner feature must ALWAYS stop cloning: clear the spoof
+     * flag so the badge drops the cloned identity and any later ble_on (Mouse/Update)
+     * rebuilds the advertisement with the badge's OWN address, not the clone's. Without this
+     * the spoof leaks past this screen (rcsp_make_set_adv_data reapplies the cloned MAC
+     * while g_badge_spoof_mode is still active). ble_off() below then stops advertising. */
+    if (g_badge_spoof_mode) {
+        printf("scanner: exit -> stop spoof (restore own identity)\n");
+        g_badge_spoof_mode = 0;
+    }
+
+    g_ble_want_on = 0;
+    ble_off();
+
+    lv_scr_load(g_menu_scr);
+    kp_set_menu();
+}
+
+/* Leaving the detail scene: drop the GATT central link and resume scanning. */
+/* Clone/spoof: advertise as the tapped OPEN device — its MAC (le_controller_set_mac) + its
+ * raw ADV (spoof branch of rcsp_make_set_adv_data). Leaves the central role (drops any GATT link + the
+ * observer scan) and comes up as a connectable peripheral. Open-comms clone only. */
+static void spoof_start(void)
+{
+    extern void badge_gatt_disconnect(void);
+    u8 n = g_scanner_detail_dev.adv_len;
+    if (n > sizeof(g_badge_spoof_adv)) { n = sizeof(g_badge_spoof_adv); }
+    memcpy(g_badge_spoof_adv, g_scanner_detail_dev.adv_data, n);
+    g_badge_spoof_adv_len = n;
+    memcpy(g_badge_spoof_mac, g_scanner_detail_dev.address, 6);
+    badge_gatt_disconnect();        /* leaves the central role (done here already, not by ble_off) */
+    ble_op_scan_enable2(0, 0);      /* stops the observer scan */
+    g_scanner_browsing = 0;
+    /* Switch identity IN PLACE on the live advertising handle. The BLE module is already
+     * ON (scanner_screen_open), so do NOT use ble_off()/ble_on(): that path issues an
+     * ASYNC disconnect and lets the stack re-auto-advertise, producing an adv-open that the
+     * app-side disable never matches with a close — the controller leaks a le_hw_advertising HW set
+     * per clone and trips the "BLE HW NUM limit" assert after ~4 cycles. Instead do a balanced
+     * adv-disable (ll_adv_close -> le_hw_close frees the set) then rebuild the adv with the
+     * spoof MAC and re-enable (ll_adv_open reopens the SAME handle, net HW delta = 0). */
+    extern void rcsp_bt_ble_adv_enable(u8 enable);
+    extern int  rcsp_make_set_adv_data(void);
+    extern int  rcsp_make_set_rsp_data(void);
+    g_badge_spoof_mode = 1;
+    rcsp_bt_ble_adv_enable(0);
+    os_time_dly(2);
+    rcsp_make_set_adv_data();       /* set the spoof MAC + cloned ADV before re-enabling */
+    rcsp_make_set_rsp_data();
+    rcsp_bt_ble_adv_enable(1);
+    printf("spoof: advertising as %02X:%02X:%02X:%02X:%02X:%02X (%s), adv_len=%d\n",
+           g_badge_spoof_mac[5], g_badge_spoof_mac[4], g_badge_spoof_mac[3],
+           g_badge_spoof_mac[2], g_badge_spoof_mac[1], g_badge_spoof_mac[0],
+           g_scanner_detail_dev.name, n);
+}
+static void spoof_stop(void)
+{
+    extern void rcsp_bt_ble_adv_enable(u8 enable);
+    if (!g_badge_spoof_mode) { return; }
+    /* Keep the module ON (no ble_off): a balanced adv-disable frees the controller's set
+     * (ll_adv_close -> le_hw_close). Clearing the flag makes the next adv rebuild restore
+     * the badge's OWN address (rcsp_make_set_adv_data picks g_rcsp_own_ble_addr). */
+    rcsp_bt_ble_adv_enable(0);
+    g_badge_spoof_mode = 0;
+    printf("spoof: stopped\n");
+}
+static void scanner_detail_back_cb(lv_event_t *e)
+{
+    (void)e;
+    spoof_stop();   /* if we were cloning, stop the clone advertisement + clear the flag (the module stays ON) */
+    extern void badge_gatt_disconnect(void);
+    badge_gatt_disconnect();
+    g_scanner_browsing = 0;
+    g_scanner_detail_active = 0;   /* leaving the scene: Button 2 goes back to list navigation */
+    if (g_scanner_active) {
+        /* The module is never ble_off'd during spoof, so no need to re-set it with ble_on() —
+         * just resume the observer scan (advertising stays off, as when the scanner opened). */
+        ble_op_scan_enable2(1, 0);
+    }
+    lv_scr_load(g_scanner_scr);
+    kp_set_one(g_scanner_keytgt);
+}
+
+/* Decode the stored advertising data to a readable dump, nRF-Connect style: flags,
+ * advertised service UUIDs (16 and 128 bit), TX power, appearance, manufacturer/service data. */
+static void scanner_format_adv(const scanner_dev_t *d, char *out, int outsz)
+{
+    int n = 0;
+    n += snprintf(out + n, outsz - n, "%02X:%02X:%02X:%02X:%02X:%02X\n%s   RSSI: %d dBm\n\n",
+                  d->address[0], d->address[1], d->address[2],
+                  d->address[3], d->address[4], d->address[5],
+                  d->type == SCANNER_TYPE_BR ? "Classic" : "BLE", d->rssi);
+
+    if (d->type == SCANNER_TYPE_BR || d->adv_len == 0) {
+        snprintf(out + n, outsz - n, "(no advertising data)");
+        return;
+    }
+
+    int svc = 0;
+    for (int i = 0; i < d->adv_len && n < outsz - 48; ) {
+        u8 len = d->adv_data[i];
+        if (len == 0 || (i + 1 + len) > d->adv_len) {
+            break;
+        }
+        u8 t = d->adv_data[i + 1];
+        const u8 *v = &d->adv_data[i + 2];
+        u8 vlen = len - 1;
+        switch (t) {
+        case 0x01:   /* Flags */
+            n += snprintf(out + n, outsz - n, "Flags: 0x%02X\n", v[0]);
+            break;
+        case 0x02: case 0x03:   /* 16-bit service UUIDs (incomplete/complete) */
+        case 0x14:              /* 16-bit service solicitation */
+            for (int j = 0; j + 1 < vlen && n < outsz - 24; j += 2) {
+                n += snprintf(out + n, outsz - n, "Service: 0x%04X\n", v[j] | (v[j + 1] << 8));
+                svc++;
+            }
+            break;
+        case 0x06: case 0x07: {   /* 128-bit service UUIDs */
+            if (vlen >= 16) {
+                n += snprintf(out + n, outsz - n,
+                              "Service: %02X%02X%02X%02X-%02X%02X-%02X%02X-%02X%02X-%02X%02X%02X%02X%02X%02X\n",
+                              v[15], v[14], v[13], v[12], v[11], v[10], v[9], v[8],
+                              v[7], v[6], v[5], v[4], v[3], v[2], v[1], v[0]);
+                svc++;
+            }
+            break;
+        }
+        case 0x0A:   /* TX power */
+            n += snprintf(out + n, outsz - n, "TX Power: %d dBm\n", (s8)v[0]);
+            break;
+        case 0x19:   /* Appearance */
+            if (vlen >= 2) {
+                n += snprintf(out + n, outsz - n, "Appearance: 0x%04X\n", v[0] | (v[1] << 8));
+            }
+            break;
+        case 0x16:   /* Service data (16-bit) */
+            if (vlen >= 2) {
+                n += snprintf(out + n, outsz - n, "Svc Data: 0x%04X (%dB)\n", v[0] | (v[1] << 8), vlen - 2);
+                svc++;
+            }
+            break;
+        case 0xFF:   /* Manufacturer-specific data */
+            if (vlen >= 2) {
+                n += snprintf(out + n, outsz - n, "Mfg: 0x%04X (%dB)\n", v[0] | (v[1] << 8), vlen - 2);
+            }
+            break;
+        default:
+            n += snprintf(out + n, outsz - n, "AD 0x%02X (%dB)\n", t, vlen);
+            break;
+        }
+        i += 1 + len;
+    }
+    if (svc == 0 && n < outsz - 32) {
+        snprintf(out + n, outsz - n, "\n(no services advertised)");
+    }
+}
+
+/* Compose the detail label = advertised data + live GATT service list (updated as discovery runs).
+ * Called on open and whenever badge_gatt_take_dirty() reports new discovery results. */
+static void scanner_detail_render(void)
+{
+    static char buf[2048];
+    scanner_format_adv(&g_scanner_detail_dev, buf, sizeof(buf));
+    int n = strlen(buf);
+
+    if (g_scanner_detail_dev.type != SCANNER_TYPE_BR) {
+        extern int badge_gatt_get_state(void);
+        extern const char *badge_gatt_get_text(void);
+        extern const char *badge_gatt_get_diag(void);
+        int st = badge_gatt_get_state();
+        const char *sts = (st == 1) ? "Connecting..." :
+                          (st == 2) ? "Discovering..." :
+                          (st == 4) ? "Connection failed" : "";
+        n += snprintf(buf + n, sizeof(buf) - n, "\n---- GATT services ----\n%s", sts);
+        if (st == 4) {
+            n += snprintf(buf + n, sizeof(buf) - n, "%s", badge_gatt_get_diag());
+        }
+        const char *gt = badge_gatt_get_text();
+        if (gt && gt[0]) {
+            snprintf(buf + n, sizeof(buf) - n, "%s", gt);
+        }
+    }
+    lv_label_set_text(g_scanner_detail_lbl, buf);
+}
+
+static void scanner_item_cb(lv_event_t *e)
+{
+    int idx = (int)(size_t)lv_event_get_user_data(e);
+
+    OS_SR_ALLOC();
+    OS_ENTER_CRITICAL();
+    if (idx < 0 || idx >= g_scanner_dev_count) {
+        OS_EXIT_CRITICAL();
+        return;
+    }
+    g_scanner_detail_dev = g_scanner_devs[idx];   /* snapshot */
+    OS_EXIT_CRITICAL();
+
+    lv_label_set_text(g_scanner_detail_title,
+                      g_scanner_detail_dev.name[0] ? g_scanner_detail_dev.name : "(no name)");
+
+    if (g_scanner_spoof_intent) {
+        /* Spoofing flow (from the "Spoofing Bluetooth" menu): CLONE this open device — advertise
+         * as it (MAC + raw ADV). Back stops the clone and restores the badge's MAC. */
+        if (g_scanner_detail_dev.type != SCANNER_TYPE_BR) {
+            spoof_start();
+        }
+        lv_label_set_text_fmt(g_scanner_detail_lbl,
+                              "CLONING (open-comms)\n\n%s\n%02X:%02X:%02X:%02X:%02X:%02X\n\n"
+                              "Advertising as this device.\nBack to stop + restore MAC.",
+                              g_scanner_detail_dev.name[0] ? g_scanner_detail_dev.name : "(no name)",
+                              g_scanner_detail_dev.address[5], g_scanner_detail_dev.address[4],
+                              g_scanner_detail_dev.address[3], g_scanner_detail_dev.address[2],
+                              g_scanner_detail_dev.address[1], g_scanner_detail_dev.address[0]);
+        g_scanner_detail_active = 0;   /* no GATT retry in spoof mode */
+    } else {
+        /* Scanner flow: connect as central + browse GATT. Stop the UI observer scan first: the
+         * real RCSP client (bt_ble_create_connection) arms its own initiator scan window, so it doesn't
+         * need the UI scan. Left at ~100% duty the UI scan collides with the initiator scan and
+         * hogs the radio during establishment, starving the master's first data anchor. The scan
+         * resumes in scanner_detail_back_cb. */
+        g_scanner_browsing = 1;
+        if (g_scanner_detail_dev.type != SCANNER_TYPE_BR) {
+            ble_op_scan_enable2(0, 0);   /* frees the radio for the master's data anchor */
+            extern void badge_gatt_connect(const u8 *addr, u8 addr_type);
+            badge_gatt_connect(g_scanner_detail_dev.address, g_scanner_detail_dev.addr_type);
+            g_scanner_gatt_start_ms = timer_get_ms();
+            g_scanner_gatt_attempt_ms = g_scanner_gatt_start_ms;
+        }
+        scanner_detail_render();
+        g_scanner_detail_active = 1;   /* in this scene, physical Button 2 = retry GATT */
+    }
+    printf("scanner: open detail for %s%s\n", g_scanner_detail_dev.name,
+           g_scanner_spoof_intent ? " [CLONE]" : "");
+
+    /* Always open the card scrolled to the very top (LVGL keeps a per-object scroll offset). */
+    if (g_scanner_detail_card) { lv_obj_scroll_to_y(g_scanner_detail_card, 0, LV_ANIM_OFF); }
+    lv_scr_load(g_scanner_detail_scr);
+    kp_set_one(g_scanner_detail_keytgt);   /* physical button = back to the list */
+    badge_dbg_lvmem("detail");
+}
