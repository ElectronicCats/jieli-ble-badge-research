+    _BEGIN_, 0xd3, 0x28, 0x13, _END_,
+    _BEGIN_, 0xd7, 0x18, 0x30, _END_,
+    _BEGIN_, 0xde, 0x01, _END_,
+    _BEGIN_, 0xb7, 0x17, 0xa7, 0x64, 0x3b, 0x06, 0x36, 0x19, 0x15, _END_,
