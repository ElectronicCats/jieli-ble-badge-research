+/* No power-off control, on purpose.
+ *
+ * A "Power off" button was tried here and removed: power_set_soft_poweroff() does stop the
+ * badge (the screen freezes mid-animation as the display peripheral dies), but nothing
+ * brings it back. Holding the button does NOT boot it, even though PB07 carries both the
+ * ADKEY buttons and CONFIG_RESET_PIN (RESET = PB07_08_0 in isd_config.ini) — that
+ * assumption did not hold on hardware. Recovery needed the USB bootloader.
+ *
+ * A dedicated power key would be on PC03_1, but this board's config uses PC03 for
+ * TCFG_LCD_PIN_RESET, so the power path is not wired for a separate power key.
+ * Verify a working power-on gesture before re-adding any power-off control; shipping
+ * one without it can leave the badge recoverable only over USB.
+ *
+ * Note also that sys_enter_soft_poweroff() is not usable here: it only starts an
+ * async four-stage sequence that ends in the factory clock UI this LVGL menu replaced
+ * ("[power_off_wait_ui] TODO"), and returns early on a latched
+ * app_var.goto_poweroff_flag — which a low battery sets on its own via
+ * POWER_EVENT_POWER_LOW, permanently blocking every later power-off request. */
+
+static void update_open_cb(lv_event_t *e)
+{
+    (void)e;
+    printf("update: enter (BLE on)\n");
+    g_badge_update_active = 0;
+    g_badge_mouse_mode = 0;   /* advertise as EC-BADGE */
+    /* Clear stored SM bonds so a phone always pairs FROM SCRATCH on the update screen. A
+     * stale bond (from an earlier pairing, or the same-MAC sibling badge the phone once paired)
+     * makes the badge answer the phone's encryption with RECONNECT + a mismatched LTK ->
+     * PIN_KEY_MISS -> disconnect(reason 5), so a companion app can connect in a loop and
+     * never finish recognizing the badge. Clearing the DB here forces a clean re-pair. */
+    {
+        extern int  le_device_db_count(void);
+        extern void le_device_db_remove(int index);
+        int n = le_device_db_count();
+        printf("update: clearing %d SM bond(s) for a fresh pair\n", n);
+        while (n-- > 0) { le_device_db_remove(n); }
+    }
+    /* Run the whole update screen WITHOUT SM bonding (just-works, no stored LTK). During
+     * pass-1 of the RCSP loader-download the updater relocates+erases the live VM sector (0xFB000);
+     * if a (re)pairing then stores a bond, ble_list_pair_add -> reflash_remote_info ->
+     * vm_write collides with the erased VM magic -> vm.c ASSERT(p_vm_magic >= magic) -> crash at ~95%.
+     * A mid-transfer BlueZ reconnect re-pairs continuously, so this is not hypothetical. Without
+     * bonding there is no VM write on pairing, so reconnects are harmless. Normal HID/mouse mode
+     * restores bonding on exit (update_back_cb). */
+    {
+        extern void sm_set_authentication_requirements(u8 auth_req);
+        sm_set_authentication_requirements(0x00 /* SM_AUTHREQ_NO_BONDING */);
+    }
+    /* Clear the HID "require encryption" bits (the Mouse screen sets them): a read with encryption
+     * required during BlueZ service discovery would force the unstable bond that blocks the OTA. Shared
+     * GATT db, so this must run before ble_on(). */
+    {
+        extern void rcsp_hid_att_require_encryption(u8 on);
+        rcsp_hid_att_require_encryption(0);
+    }
+    g_ble_want_on = 1;
+    ble_on();
+    lv_obj_set_style_bg_color(g_update_scr, lv_color_hex(0x0000C0), 0);   /* BLUE = v2 (dual-bank A1 OTA marker: v1 was green 0x00A000; blue confirms the 0xC0 OTA applied) */
+    lv_label_set_text(g_update_lbl, "UPDATE MODE v2\nwaiting for connection\nbutton 1 = back");
+    lv_scr_load(g_update_scr);
+    g_on_update_scr = 1;
+    kp_set_one(g_update_keytgt);
+}
+
+static void update_back_cb(lv_event_t *e)
+{
+    (void)e;
+    if (g_badge_update_active) { return; }   /* locked while an update is in progress */
+    printf("update: exit (BLE off)\n");
+    /* Restore SM bonding for normal mode (HID/mouse); the update screen ran without it. */
+    {
+        extern void sm_set_authentication_requirements(u8 auth_req);
+        sm_set_authentication_requirements(0x01 | 0x04 /* SM_AUTHREQ_BONDING | MITM_PROTECTION */);
+    }
+    g_on_update_scr = 0;
+    g_ble_want_on = 0;
+    ble_off();
+    lv_scr_load(g_settings_scr);
+    kp_set_settings();
+}
