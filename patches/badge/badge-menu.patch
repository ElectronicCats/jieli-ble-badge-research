diff --git a/SDK/apps/common/third_party_profile/jieli/rcsp/qix_raw_flash.c b/SDK/apps/common/third_party_profile/jieli/rcsp/qix_raw_flash.c
new file mode 100644
index 0000000..8c52efb
--- /dev/null
+++ b/SDK/apps/common/third_party_profile/jieli/rcsp/qix_raw_flash.c
@@ -0,0 +1,351 @@
+/*
+ * Qix raw-flash service — part of the badge menu firmware (-DCONFIG_BADGE_MENU).
+ * Adds direct erase/write/read access to ANY flash partition on top of the existing
+ * Qix FD00 GATT service, so a host can replace the UI resources in place (SDFILE
+ * 0x17E000), VIRFAT (0x33E000), etc. — regions the app-only dual_bank OTA
+ * (0xC0..0xC5, only the app code banks) physically CANNOT touch.
+ *
+ * The running CODE region [0, RAW_CODE_PROTECT_END) is write-protected so a raw write
+ * can't brick the live app/uboot (replace the app via the dual_bank Qix OTA or USB ISP
+ * instead). See the full-4mb-ota-not-via-qix analysis.
+ *
+ * Hooked in via a 4-line hook in qix_ota_server.c::qix_handle_frame():
+ *     #ifdef CONFIG_BADGE_MENU
+ *         if (qix_raw_flash_handle(cmd, p, plen)) return;
+ *     #endif
+ *
+ * A raw-flash command also raises g_badge_update_active, which the LVGL menu's Update
+ * screen consumes to go green and block Back while an upload runs (so the link doesn't
+ * drop mid-flash) — the BLE on/off control in the update flow.
+ *
+ * Wire (Qix frame [0x9E][cksum][flags][cmd][len LE16][payload], cksum=sum(bytes[2:])&0xFF):
+ *   0xD0 RAW_ERASE  [addr LE32][len LE32]    -> 0xD8 [st][addr LE32]
+ *   0xD1 RAW_WRITE  [addr LE32][data...]     -> 0xD9 [st][next_addr LE32]
+ *   0xD2 RAW_READ   [addr LE32][len u8<=16]  -> 0xDA [st][data...]
+ *   0xD3 RAW_REBOOT []                       -> 0xDB [st], then cpu_reset
+ *   st: 0=ok, 1=flash error, 2=protected / out of range
+ */
+#ifdef CONFIG_BADGE_MENU
+
+#include "app_config.h"             /* defines TCFG_COMPELTE_UFW_LC_EN */
+#include "system/includes.h"
+#include "btstack/le/att.h"
+#include "btstack/le/ble_api.h"
+#include "btstack/bluetooth.h"
+
+#define raw_log(fmt, ...)   printf("[BADGE-RAW] " fmt "\n", ##__VA_ARGS__)
+
+/* FD01 value handle (NOTIFY to client) — must match qix_ota_server.c. */
+#define QIX_FD01_VAL_HANDLE       0x0018
+
+#define QIX_CMD_RAW_ERASE         0xD0
+#define QIX_CMD_RAW_WRITE         0xD1
+#define QIX_CMD_RAW_READ          0xD2
+#define QIX_CMD_RAW_REBOOT        0xD3
+#define QIX_CMD_RAW_RET_ERASE     0xD8
+#define QIX_CMD_RAW_RET_WRITE     0xD9
+#define QIX_CMD_RAW_RET_READ      0xDA
+#define QIX_CMD_RAW_RET_REBOOT    0xDB
+#define QIX_CMD_RAW_APPLY         0xD4   /* [addr LE32][len LE32]: apply a staged code .ufw */
+#define QIX_CMD_RAW_RET_APPLY     0xDC   /* [st]: 0 ok (device verifies + resets to uboot) */
+
+/* 4 MB map: CODE 0..0x17E000 | SDFILE/ui_res 0x17E000 | VIRFAT 0x33E000 | DATA 0x3BE000 */
+#define RAW_CODE_PROTECT_END      0x17E000
+#define RAW_FLASH_END             0x400000
+/* Per-device config at the top: DATA 0x3BE000 | VM | BTIF (holds CFG_BT_MAC_ADDR) |
+ * EXIF, up to 0x400000. All OPT=1 (preserved by the .ufw apply). Raw erase/write must
+ * never reach it: erasing BTIF makes the badge boot with no MAC and generate a NEW random
+ * one (user_cfg.c:327), silently changing the device address. Staging tops out at
+ * 0x3BE000 anyway, so this only rejects out-of-range commands. Reads are unrestricted. */
+#define RAW_CONFIG_PROTECT_START  0x3BE000
+#define IOCTL_ERASE_SECTOR_CMD    200      /* IOCTL_ERASE_SECTOR (interface/utils/device/ioctl_cmds.h) */
+
+/* Raw access to internal flash (implemented in update.a / flash lib). */
+extern int tzflash_write(const void *buf, u32 len, u32 offset);
+extern int tzflash_read(void *buf, u32 len, u32 offset);
+extern int tzflash_ioctl(u32 cmd, u32 arg);
+
+/* Send a Qix frame via FD01 notify (mirrors qix_ota_server.c::qix_send_frame). */
+static void raw_send(u8 cmd, const u8 *payload, u16 plen)
+{
+    u8 f[6 + 32];
+    if (plen > sizeof(f) - 6) {
+        return;
+    }
+    f[0] = 0x9E;
+    f[2] = 0x00;            /* flags */
+    f[3] = cmd;
+    f[4] = plen & 0xFF;
+    f[5] = (plen >> 8) & 0xFF;
+    if (plen) {
+        memcpy(&f[6], payload, plen);
+    }
+    u32 sum = 0;
+    for (u16 i = 2; i < 6 + plen; i++) {
+        sum += f[i];
+    }
+    f[1] = sum & 0xFF;
+    ble_op_att_send_data(QIX_FD01_VAL_HANDLE, f, 6 + plen, ATT_OP_NOTIFY);
+}
+
+/* Erase the 4 KB sectors covering [addr, addr+len). 0 ok, 1 flash err, 2 protected. */
+static u8 raw_erase(u32 addr, u32 len)
+{
+    if (addr < RAW_CODE_PROTECT_END || addr >= RAW_CONFIG_PROTECT_START) {
+        return 2;
+    }
+    u32 a   = addr & ~0xFFFUL;          /* align down to 4 KB */
+    u32 end = addr + len;
+    if (end > RAW_CONFIG_PROTECT_START) {
+        end = RAW_CONFIG_PROTECT_START;
+    }
+    while (a < end) {
+        if (tzflash_ioctl(IOCTL_ERASE_SECTOR_CMD, a) != 0) {
+            return 1;
+        }
+        a += 0x1000;
+    }
+    return 0;
+}
+
+static void raw_reboot_cb(void *priv)
+{
+    cpu_reset();
+}
+
+#if TCFG_COMPELTE_UFW_LC_EN
+/* ---- Full-firmware CODE apply (BLE bootstrap loader) --------
+ * The host raw-flashes a CODE-only .ufw to a free staging region (above the resources it
+ * also raw-flashes), then sends 0xD4 RAW_APPLY [addr][len]. We verify it and hand it to
+ * the resident uboot via the SDK's lc_flash update path: uboot reads the .ufw from `addr`
+ * (passed in UPDATA_PARM.parm_priv), writes the CODE partition in internal flash and
+ * reboots into the new firmware. Unlike the SDK default, this reads the staged .ufw RAW
+ * from a flash address (our tzflash_read) instead of an SDFILE file, so staging isn't
+ * tied to the FS. */
+#include "update.h"
+#include "update_loader_download.h"
+
+extern const int support_lc_flash_ufw_update_en;
+
+static u32 stg_ufw_base = 0;   /* flash addr of the staged code .ufw */
+static u32 stg_ufw_len  = 0;
+static u32 stg_ufw_cur  = 0;   /* sequential read cursor for the op_api */
+
+/* update_file_verify() callback: absolute flash addr -> raw read. */
+static s32 stg_ufw_verify_read(void *buf, u32 addr, u32 len)
+{
+    return (tzflash_read(buf, len, addr) < 0) ? -1 : (s32)len;
+}
+
+static u16 stg_op_f_open(void)
+{
+    stg_ufw_cur = 0;
+    return 1;
+}
+static u16 stg_op_f_read(void *fp, u8 *buff, u16 len)
+{
+    if (tzflash_read(buff, len, stg_ufw_base + stg_ufw_cur) < 0) {
+        return 0;
+    }
+    stg_ufw_cur += len;
+    return len;
+}
+static int stg_op_f_seek(void *fp, u8 type, u32 offset)
+{
+    if (type == SEEK_SET) {
+        stg_ufw_cur = offset;
+    } else if (type == SEEK_CUR) {
+        stg_ufw_cur += offset;
+    } else {                       /* SEEK_END */
+        stg_ufw_cur = stg_ufw_len + offset;
+    }
+    return 0;
+}
+static u16 stg_op_f_stop(u8 err)
+{
+    return 0;
+}
+static int stg_op_notify_size(void *priv, u32 size)
+{
+    return 0;
+}
+
+static const update_op_api_t stg_update_op_api = {
+    .ch_init = NULL,
+    .f_open = stg_op_f_open,
+    .f_read = stg_op_f_read,
+    .f_seek = stg_op_f_seek,
+    .f_stop = stg_op_f_stop,
+    .notify_update_content_size = stg_op_notify_size,
+};
+
+/* Tells uboot where the staged .ufw lives (parm_priv = {src_addr, src_len}). */
+static void stg_param_fill(UPDATA_PARM *p)
+{
+    struct {
+        u32 addr;
+        u32 len;
+    } info = { stg_ufw_base, stg_ufw_len };
+    memcpy(p->parm_priv, &info, sizeof(info));
+}
+static void stg_before_jump(int type)
+{
+    printf("[OTA-DBG] stg_before_jump type=%d -> cpu_reset() (uboot will write CODE on next boot)\n", type);
+    cpu_reset();
+}
+static void stg_update_state_cbk(int type, u32 state, void *priv)
+{
+    update_ret_code_t *rc = (update_ret_code_t *)priv;
+    printf("[OTA-DBG] stg_update_state_cbk type=%d state=%u stu=%d err=0x%x\n",
+           type, state, rc ? rc->stu : -1, rc ? rc->err_code : 0);
+    if (state == UPDATE_CH_EXIT) {
+        if (rc && rc->stu == 0 && rc->err_code == 0) {
+            printf("[OTA-DBG] apply VERIFY OK -> update_mode_api_v2(USER_LC_FLASH_UFW_UPDATA) base=0x%x len=%u\n",
+                   (unsigned)stg_ufw_base, (unsigned)stg_ufw_len);
+            update_mode_api_v2(USER_LC_FLASH_UFW_UPDATA, stg_param_fill, stg_before_jump);
+        } else {
+            printf("[OTA-DBG] apply VERIFY FAIL stu=%d err=0x%x (NOT applying)\n",
+                   rc ? rc->stu : -1, rc ? rc->err_code : 0);
+            raw_log("apply verify fail stu=%d err=0x%x",
+                    rc ? rc->stu : -1, rc ? rc->err_code : 0);
+        }
+    }
+}
+
+/* Verify the staged .ufw and start the apply task. 0 = started (the device then resets
+ * to uboot and writes the code partition). Negative = error. */
+static int raw_apply_staged(u32 addr, u32 len)
+{
+    printf("[OTA-DBG] raw_apply_staged addr=0x%x len=%u lc_en=%d\n",
+           (unsigned)addr, (unsigned)len, support_lc_flash_ufw_update_en);
+    if (support_lc_flash_ufw_update_en == 0) {
+        printf("[OTA-DBG] raw_apply_staged: lc_flash apply NOT compiled in -> abort\n");
+        return -1;
+    }
+    stg_ufw_base = addr;
+    stg_ufw_len  = len;
+    stg_ufw_cur  = 0;
+    int vr = update_file_verify(addr, stg_ufw_verify_read);
+    printf("[OTA-DBG] update_file_verify(0x%x) = %d %s\n", (unsigned)addr, vr,
+           vr == 0 ? "(staged .ufw is VALID)" : "(staged .ufw INVALID -> abort)");
+    if (vr != 0) {
+        return -2;
+    }
+    static update_mode_info_t info;
+    info.type      = USER_LC_FLASH_UFW_UPDATA;
+    info.state_cbk = stg_update_state_cbk;
+    info.p_op_api  = &stg_update_op_api;
+    info.task_en   = 1;
+    printf("[OTA-DBG] starting app_active_update_task_init (apply task)\n");
+    app_active_update_task_init(&info);
+    return 0;
+}
+
+/* Public entry point for the single-bank Qix OTA path 0xC0/0xC2/0xC5 (qix_ota_server.c):
+ * applies a code .ufw already staged (raw) at [addr, addr+len) via the resident uboot's
+ * single-bank lc_flash update — identical to the 0xD4 RAW_APPLY command. */
+int qix_stage_apply(u32 addr, u32 len)
+{
+    return raw_apply_staged(addr, len);
+}
+#endif /* TCFG_COMPELTE_UFW_LC_EN */
+
+/* Try to handle a raw-flash command. Returns 1 if handled, 0 to pass it to the normal
+ * Qix OTA dispatch. Called from qix_handle_frame() under CONFIG_BADGE_MENU. */
+int qix_raw_flash_handle(u8 cmd, const u8 *p, u16 plen)
+{
+    /* A raw-flash command means an update is being uploaded: tell the badge menu to turn
+     * the Update screen green and block Back (it must not leave mid-upload — that would cut
+     * the BLE link). Cleared by the reboot at the end of the deploy. */
+    if (cmd == QIX_CMD_RAW_ERASE || cmd == QIX_CMD_RAW_WRITE || cmd == QIX_CMD_RAW_APPLY) {
+        extern volatile u8 g_badge_update_active;
+        g_badge_update_active = 1;
+    }
+
+    if (cmd == QIX_CMD_RAW_ERASE) {
+        if (plen < 8) {
+            return 1;
+        }
+        u32 addr = p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);
+        u32 len  = p[4] | (p[5] << 8) | (p[6] << 16) | ((u32)p[7] << 24);
+        u8 st = raw_erase(addr, len);
+        raw_log("RAW_ERASE @0x%x len=%u -> st=%u", addr, len, st);
+        u8 r[5];
+        r[0] = st;
+        r[1] = addr & 0xFF; r[2] = (addr >> 8) & 0xFF; r[3] = (addr >> 16) & 0xFF; r[4] = (addr >> 24) & 0xFF;
+        raw_send(QIX_CMD_RAW_RET_ERASE, r, 5);
+        return 1;
+    }
+
+    if (cmd == QIX_CMD_RAW_WRITE) {
+        if (plen < 5) {
+            return 1;
+        }
+        u32 addr = p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);
+        const u8 *data = p + 4;
+        u16 dlen = plen - 4;
+        u8 st = 0;
+        if (addr < RAW_CODE_PROTECT_END || addr + dlen > RAW_CONFIG_PROTECT_START) {
+            st = 2;                                  /* protected / out of range */
+        } else if (tzflash_write(data, dlen, addr) < 0) {
+            st = 1;                                  /* flash write error */
+        }
+        u32 next = addr + dlen;
+        if ((addr & 0x3FFF) < dlen) {                /* log ~every 16 KB */
+            raw_log("RAW_WRITE @0x%x len=%u -> st=%u", addr, dlen, st);
+        }
+        u8 r[5];
+        r[0] = st;
+        r[1] = next & 0xFF; r[2] = (next >> 8) & 0xFF; r[3] = (next >> 16) & 0xFF; r[4] = (next >> 24) & 0xFF;
+        raw_send(QIX_CMD_RAW_RET_WRITE, r, 5);
+        return 1;
+    }
+
+    if (cmd == QIX_CMD_RAW_READ) {
+        if (plen < 5) {
+            return 1;
+        }
+        u32 addr = p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);
+        u8 rlen = p[4];
+        if (rlen > 16) {
+            rlen = 16;                               /* keep the notify payload small */
+        }
+        u8 rb[1 + 16];
+        rb[0] = 0;
+        if (addr + rlen > RAW_FLASH_END || tzflash_read(&rb[1], rlen, addr) < 0) {
+            rb[0] = 1;
+            rlen = 0;
+        }
+        raw_send(QIX_CMD_RAW_RET_READ, rb, 1 + rlen);
+        return 1;
+    }
+
+    if (cmd == QIX_CMD_RAW_REBOOT) {
+        raw_log("RAW_REBOOT requested — reset in 500ms");
+        u8 r = 0;
+        raw_send(QIX_CMD_RAW_RET_REBOOT, &r, 1);
+        sys_timeout_add(NULL, raw_reboot_cb, 500);
+        return 1;
+    }
+
+#if TCFG_COMPELTE_UFW_LC_EN
+    if (cmd == QIX_CMD_RAW_APPLY) {
+        if (plen < 8) {
+            return 1;
+        }
+        u32 addr = p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);
+        u32 len  = p[4] | (p[5] << 8) | (p[6] << 16) | ((u32)p[7] << 24);
+        printf("[OTA-DBG] >>> RAW_APPLY(0xD4) received: addr=0x%x len=%u\n", (unsigned)addr, (unsigned)len);
+        int r = raw_apply_staged(addr, len);
+        printf("[OTA-DBG] <<< raw_apply_staged returned r=%d (st=%u to host)\n", r, (unsigned)((r == 0) ? 0 : (u8)(-r)));
+        raw_log("RAW_APPLY @0x%x len=%u -> r=%d", addr, len, r);
+        u8 st = (r == 0) ? 0 : (u8)(-r);
+        raw_send(QIX_CMD_RAW_RET_APPLY, &st, 1);
+        return 1;
+    }
+#endif
+
+    return 0;   /* not a raw command — let the normal Qix OTA dispatch handle it */
+}
+
+#endif /* CONFIG_BADGE_MENU */
