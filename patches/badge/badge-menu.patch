+     * usually writes 0x0002 (INDICATE), Android/BlueZ write 0x0001 (NOTIFY). Capture the
+     * value so ble_hid_mouse_report() emits the matching ATT operation — otherwise iOS
+     * silently drops every report (pairs but the cursor never moves). */
+    if (att_handle == 0x0028 && buffer_size >= 2) {
+        u16 ccc = buffer[0] | (buffer[1] << 8);
+        extern void ble_hid_report_ccc_set(u16 ccc_value);
+        ble_hid_report_ccc_set(ccc);
+        printf("badge: report CCC = 0x%04x (%s)\n", ccc,
+               (ccc & 0x0002) ? "INDICATE" : ((ccc & 0x0001) ? "NOTIFY" : "off"));
+    }
