+static void mouse_open_cb(lv_event_t *e)
+{
+    (void)e;
+    /* Close classic BR/EDR while the mouse is active. This firmware is a watch: it keeps
+     * classic BT discoverable/connectable as "EC-BADGE" AND auto-pages a paired phone to
+     * reconnect. A phone then pairs/connects the CLASSIC identity (no HID) instead of the
+     * BLE HID "EC-MOUSE" — the mouse "pairs but does nothing / disconnects". Confirmed on
+     * the UART: the badge paged + connected the phone over classic (lmp_rx_start_encryption_req)
+     * and no BLE link was ever established. Turning off BR/EDR
+     * leaves only the BLE HID peripheral, so the phone connects it over HOGP. Reopened in
+     * mouse_back_cb. */
+    extern u8 is_bredr_close(void);
+    extern void bt_close_bredr(void);
+    if (!is_bredr_close()) { bt_close_bredr(); }
+    printf("mouse: enter (BLE on, classic OFF)\n");
+    g_badge_mouse_mode = 1;   /* advertise as EC-MOUSE */
+    /* HOGP: require encryption on the HID report characteristics so iOS pairs and moves the
+     * cursor. The Update/OTA screen clears it again (shared GATT db). Must precede ble_on(). */
+    {
+        extern void rcsp_hid_att_require_encryption(u8 on);
+        rcsp_hid_att_require_encryption(1);
+    }
+    g_ble_want_on = 1;
+    ble_on();
+    lv_scr_load(g_mouse_scr);
+    kp_set_one(g_mouse_keytgt);   /* Button 1 = back (the trackpad has no on-screen Back) */
+    badge_dbg_lvmem("mouse");
+}
+
+static void mouse_back_cb(lv_event_t *e)
+{
+    (void)e;
+    printf("mouse: exit (BLE off)\n");
+    ble_off();                 /* clears g_ble_want_on + waits for the link to actually drop */
+    g_badge_mouse_mode = 0;    /* exits mouse mode so nothing re-advertises a stale "EC-MOUSE" */
+    /* Classic BR/EDR stays OFF (closed in mouse_open_cb; not reopened — the badge is BLE-only). */
+    lv_scr_load(g_menu_scr);
+    kp_set_menu();
+}
