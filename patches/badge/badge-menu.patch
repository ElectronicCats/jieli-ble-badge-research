+extern struct lcd_spi_platform_data *lcd_get_platform_data();
+
+static void delay_2ms(int cnt)
+{
+    if (cnt * 2 > 10) {
+        os_time_dly(cnt * 2 / 10 + 1);
+    } else {
+        mdelay(2 * cnt);
+    }
+}
+
+static int lcd_qspi_badge2_power_ctrl(u8 onoff)
+{
+    lcd_en_ctrl(onoff);
+    return 0;
+}
+
+static void lcd_qspi_badge2_entersleep(void)
+{
+    lcd_write_cmd(0x28, NULL, 0);
+    lcd_write_cmd(0x10, NULL, 0);
+    delay_2ms(120 / 2);
+}
+
+static void lcd_qspi_badge2_exitsleep(void)
+{
+    lcd_write_cmd(0x11, NULL, 0);
+    delay_2ms(5);
+    lcd_write_cmd(0x29, NULL, 0);
+}
+
+static u32 lcd_qspi_badge2_read_id(void)
+{
+    u8 id1 = 0, id2 = 0, id3 = 0, a7 = 0;
+    lcd_read_cmd(0xda, &id1, 1);
+    lcd_read_cmd(0xdb, &id2, 1);
+    lcd_read_cmd(0xdc, &id3, 1);
+    lcd_read_cmd(0xa7, &a7, 1);   /* ST77916 chip-id type */
+    printf("badge2 LCD read_id: DA=%02x DB=%02x DC=%02x A7=%02x\n", id1, id2, id3, a7);
+    return ((id1 << 16) | (id2 << 8) | id3);
+}
