+
+    .lcd_type = LCD_TYPE_SPI,
+
+    .buffer_num = BUF_NUM,
+    .buffer_size = LCD_BLOCK_W * LCD_BLOCK_H * 2,
+
+    .fps = 15,   /* badge-1 value — low QSPI clock for signal integrity on the hand-wired panel */
+
+    .spi = {
+        .spi_mode = SPI_IF_MODE(LCD_DRIVE_CONFIG),
+        .pixel_type = PIXEL_TYPE(LCD_DRIVE_CONFIG),
+        .out_format = OUT_FORMAT(LCD_DRIVE_CONFIG),
+        .spi_dat_mode = SPI_MODE_UNIDIR,
+        .read_pin_select = READ_PIN_SEL_PA9,
+    },
+
+    .debug_mode_en = false,
+    .debug_mode_color = 0xff0000,
+};
+
+REGISTER_LCD_DEVICE(badge2_360) = {
+    .logo = "badge2_360",
+    .row_addr_align    = 2,
+    .column_addr_align = 2,
+
+    .radius     = SCR_W / 2,
+    .fill_argb  = 0xffffffff,
+
+    .lcd_cmd = (void *) &lcd_qspi_badge2_cmd_list_poweron,
+    .cmd_cnt = sizeof(lcd_qspi_badge2_cmd_list_poweron) / sizeof(lcd_qspi_badge2_cmd_list_poweron[0]),
+    .param   = (void *) &lcd_qspi_badge2_param,
+
+    .reset = NULL,
+    .backlight_ctrl = NULL,
+    .power_ctrl = lcd_qspi_badge2_power_ctrl,
+    .entersleep = lcd_qspi_badge2_entersleep,
+    .exitsleep = lcd_qspi_badge2_exitsleep,
+    .read_id = lcd_qspi_badge2_read_id,
+    .lcd_id = 0x000000,
+};
+
+#endif
+#endif
