+/* The badge boots with BLE off; it's turned on only inside Update and Mouse. Uses the
+ * module-level enable (not just the adv enable): RCSP auto-advertises at BT start, and
+ * an adv-only off gets re-enabled. ble_module_enable(0) clears adv_ctrl_en so it stays off. */
+static void ble_on(void)
+{
+    /* Declare the intent BEFORE bringing up the radio so the stack's connect/disconnect
+     * auto-advertise (rcsp_ble_adv_enable_with_con_dev) knows the menu wants BLE on. */
+    g_ble_want_on = 1;
+    /* Rebuild BOTH the ADV data and the scan response to match the mode (EC-MOUSE /
+     * EC-BADGE) before the radio comes up. g_badge_mouse_mode must already be set by the
+     * caller. In mouse mode rcsp_make_set_adv_data() emits a conformant HID advertisement
+     * (Flags + Appearance + 0x1812 in the ADV, where iOS requires them); rebuilding only the
+     * scan response left the ADV as the stale RCSP manufacturer blob, so phones never saw a
+     * HID peripheral. */
+    extern int rcsp_make_set_adv_data(void);
+    extern int rcsp_make_set_rsp_data(void);
+    rcsp_make_set_adv_data();
+    rcsp_make_set_rsp_data();
+    extern void ble_module_enable(unsigned char e);
+    ble_module_enable(1);
+    printf("ble: on (%s)\n", g_badge_mouse_mode ? "EC-MOUSE" : "EC-BADGE");
+}
+
+/* Turns BLE fully off AND waits until it is actually off before returning.
+ *
+ * ble_module_enable(0) stops advertising and REQUESTS a disconnect of any active phone link,
+ * but the disconnect is async (it only queues the HCI command). If the next screen's ble_on()
+ * runs before the link is actually down, set_adv_enable(1) issues LE-Set-Advertising-
+ * Enable while still connected — the single-link controller rejects it and the badge never
+ * advertises (this is exactly the "left Mouse while paired -> Update won't advertise -> OTA
+ * can't find the badge" bug). So here we first clear the intent (g_ble_want_on = 0, which also
+ * stops the stack from re-auto-advertising on the disconnect event) and then block, yielding,
+ * until the controller reports zero BLE connections. Bounded and feeding the WDT. */
+static void ble_off(void)
+{
+    extern void ble_module_enable(unsigned char e);
+    extern u8 bt_rcsp_ble_conn_num(void);
+    extern void wdt_clear(void);
+    g_ble_want_on = 0;
+    ble_module_enable(0);
+    for (int i = 0; i < 150 && bt_rcsp_ble_conn_num() > 0; i++) {
+        wdt_clear();
+        os_time_dly(1);   /* ~10 ms/tick -> up to ~1.5 s; a disconnect normally happens in <100 ms */
+    }
+    printf("ble: off (conn=%d)\n", bt_rcsp_ble_conn_num());
+}
+
+/* Point the keypad group at the focusable objects of the shown screen.
+ * ADKEY hardware: Button 2 = LV_KEY_NEXT (navigate), Button 1 = LV_KEY_ENTER
+ * (activate the focused object). Like touch, the buttons belong to
+ * LVGL — a polled keypad indev (keypad_read) feeds these keys to this group. */
+static void kp_set_menu(void)
+{
+    if (!g_kp_group) { return; }
+    lv_group_remove_all_objs(g_kp_group);
+    /* Menu: the two hardware buttons are handled by the lock logic in the main loop
+     * (Button 1 / back = lock). Tools are opened by touch, so the keypad group is left
+     * EMPTY here — otherwise Button 1 (ENTER) would also activate a focused tool. */
+}
+static void kp_set_settings(void)
+{
+    if (!g_kp_group) { return; }
+    lv_group_remove_all_objs(g_kp_group);
+    lv_group_add_obj(g_kp_group, g_settings_btns[0]);
+    lv_group_add_obj(g_kp_group, g_settings_btns[1]);
+    lv_group_add_obj(g_kp_group, g_settings_btns[2]);
+    lv_group_focus_obj(g_settings_btns[0]);
+}
+static void kp_set_one(lv_obj_t *o)
+{
+    if (!g_kp_group) { return; }
+    lv_group_remove_all_objs(g_kp_group);
+    lv_group_add_obj(g_kp_group, o);
+    lv_group_focus_obj(o);
+}
