+/* ----------------------------------------------------------------------------
+ *  AXS5106L touch panel (AiXin) — software bit-bang I2C on PB1/PB2.
+ *  Badge wiring (verified): SCL=PB2, SDA=PB1 (the HW IIC1 on these pins is
+ *  owned by P11), RST=PA2 (RESX, active-low), INT=PB8; 7-bit addr 0x63.
+ *  Reads reg 0x01 -> 14 bytes: d[1]=finger count, point0
+ *  X=((d[2]&0x0F)<<8)|d[3], Y=((d[4]&0x0F)<<8)|d[5]. Ported from the gpio_demo
+ *  bring-up that worked on the other SDK.
+ * -------------------------------------------------------------------------- */
+#define AXS_ADDR_7BIT   0x63
+#define AXS_RST_IO      IO_PORTA_02
+#define AXS_INT_IO      IO_PORTB_08
+#if (defined TCFG_LCD_SPI_BADGE2_ENABLE && TCFG_LCD_SPI_BADGE2_ENABLE)
+/* badge 2's CST816D sits on the HW-iic0 pins (the factory tp_cst816d uses hw iic0). We bit-bang
+ * over them as plain GPIO — the HW iic0 controller is left uninitialized in this build. */
+#define AXS_SDA_IO      IO_PORTA_05   /* HW_I2C0 DAT */
+#define AXS_SCL_IO      IO_PORTA_06   /* HW_I2C0 CLK */
+#else
+#define AXS_SDA_IO      IO_PORTB_01
+#define AXS_SCL_IO      IO_PORTB_02
+#endif
+#define AXS_REG_TOUCH   0x01
+#define AXS_REG_ID      0x08
+#define AXS_I2C_HALF_US 5
+
+extern void udelay(u32 usec);
+
+static inline void axs_sda_low(void) { gpio_set_mode(IO_PORT_SPILT(AXS_SDA_IO), PORT_OUTPUT_LOW); }
+static inline void axs_sda_rel(void) { gpio_set_mode(IO_PORT_SPILT(AXS_SDA_IO), PORT_INPUT_PULLUP_10K); }
+static inline int  axs_sda_get(void) { return gpio_read(AXS_SDA_IO); }
+static inline void axs_scl_low(void) { gpio_set_mode(IO_PORT_SPILT(AXS_SCL_IO), PORT_OUTPUT_LOW); }
+static inline void axs_scl_rel(void) { gpio_set_mode(IO_PORT_SPILT(AXS_SCL_IO), PORT_INPUT_PULLUP_10K); }
+static inline int  axs_scl_get(void) { return gpio_read(AXS_SCL_IO); }
+static inline void axs_dly(void) { udelay(AXS_I2C_HALF_US); }
+
+static void axs_scl_release_wait(void)
+{
+    axs_scl_rel();
+    for (int g = 0; g < 1000 && !axs_scl_get(); g++) {
+        udelay(1);
+    }
+}
+static void axs_i2c_start(void)
+{
+    axs_sda_rel(); axs_scl_rel(); axs_dly();
+    axs_sda_low(); axs_dly();
+    axs_scl_low(); axs_dly();
+}
+static void axs_i2c_stop(void)
+{
+    axs_sda_low(); axs_dly();
+    axs_scl_release_wait(); axs_dly();
+    axs_sda_rel(); axs_dly();
+}
+static int axs_i2c_wr(u8 b)
+{
+    for (int i = 0; i < 8; i++) {
+        if (b & 0x80) { axs_sda_rel(); } else { axs_sda_low(); }
+        b <<= 1;
+        axs_dly();
+        axs_scl_release_wait(); axs_dly();
+        axs_scl_low();
+    }
+    axs_sda_rel(); axs_dly();
+    axs_scl_release_wait(); axs_dly();
+    int ack = (axs_sda_get() == 0);
+    axs_scl_low(); axs_dly();
+    return ack;
+}
+static u8 axs_i2c_rd(int ack)
+{
+    u8 b = 0;
+    axs_sda_rel();
+    for (int i = 0; i < 8; i++) {
+        b <<= 1;
+        axs_scl_release_wait(); axs_dly();
+        if (axs_sda_get()) { b |= 1; }
+        axs_scl_low(); axs_dly();
+    }
+    if (ack) { axs_sda_low(); } else { axs_sda_rel(); }
+    axs_dly();
+    axs_scl_release_wait(); axs_dly();
+    axs_scl_low(); axs_dly();
+    axs_sda_rel();
+    return b;
+}
+static int axs_i2c_read_reg(u8 addr7, u8 reg, u8 *buf, int len)
+{
+    axs_i2c_start();
+    if (!axs_i2c_wr(addr7 << 1))       { axs_i2c_stop(); return -1; }
+    if (!axs_i2c_wr(reg))              { axs_i2c_stop(); return -2; }
+    axs_i2c_start();
+    if (!axs_i2c_wr((addr7 << 1) | 1)) { axs_i2c_stop(); return -3; }
+    for (int i = 0; i < len; i++) {
+        buf[i] = axs_i2c_rd(i < len - 1);
+    }
+    axs_i2c_stop();
+    return len;
+}
+static void axs_reset(void)
+{
+    gpio_set_mode(IO_PORT_SPILT(AXS_RST_IO), PORT_OUTPUT_HIGH);
+    os_time_dly(1);
+    gpio_set_mode(IO_PORT_SPILT(AXS_RST_IO), PORT_OUTPUT_LOW);
+    os_time_dly(20);   /* 200 ms reset */
+    gpio_set_mode(IO_PORT_SPILT(AXS_RST_IO), PORT_OUTPUT_HIGH);
+    os_time_dly(30);   /* 300 ms boot */
+}
+static int axs5106l_init(void)
+{
+    gpio_set_mode(IO_PORT_SPILT(AXS_INT_IO), PORT_INPUT_PULLUP_10K);
+    axs_sda_rel(); axs_scl_rel(); axs_dly();
+    axs_reset();
+    u8 id[2];
+    for (int t = 0; t < 5; t++) {
+        id[0] = id[1] = 0;
+        axs_i2c_read_reg(AXS_ADDR_7BIT, AXS_REG_ID, id, 2);
+        printf("axs5106l: ID try%d = 0x%02x 0x%02x\n", t, id[0], id[1]);
+        if (id[0] || id[1]) { printf("axs5106l: OK\n"); return 0; }
+        os_time_dly(10);
+    }
+    printf("axs5106l: no response (check RST PA2 / power / addr 0x63)\n");
+    return -1;
+}
+static int axs5106l_read(u16 *px, u16 *py)
+{
+    u8 d[14] = {0};
+    if (axs_i2c_read_reg(AXS_ADDR_7BIT, AXS_REG_TOUCH, d, 14) != 14) {
+        return 0;
+    }
+    u8 fingers = d[1];
+    if (fingers == 0 || fingers > 5) {
+        return 0;
+    }
+    *px = ((u16)(d[2] & 0x0F) << 8) | d[3];
+    *py = ((u16)(d[4] & 0x0F) << 8) | d[5];
+    return 1;
+}
+/* ----------------------------------------------------------------------------
+ *  CST816D touch panel (Hynitron) — second variant. Reuses the bit-bang
+ *  I2C primitives from the AXS above (SDA=PA5/SCL=PA6 for badge2, RST=PA2), only the
+ *  addr and register map change. 7-bit addr 0x15; chip-ID reg 0xA7 == 0xB5.
+ *  Reads reg 0x01 -> 6 bytes: d[1]=finger count, X=((d[2]&0x0F)<<8)|d[3],
+ *  Y=((d[4]&0x0F)<<8)|d[5]. Assumes the pins are identical to the AXS wiring on this
+ *  board family — if touch doesn't respond on the bench, that pin/bus is the lever to try. */
+#define CST_ADDR_7BIT   0x15
+#define CST_REG_TOUCH   0x01
+#define CST_REG_CHIPID  0xA7
+static int cst816d_init(void)
+{
+    gpio_set_mode(IO_PORT_SPILT(AXS_INT_IO), PORT_INPUT_PULLUP_10K);
+    axs_sda_rel(); axs_scl_rel(); axs_dly();
+    axs_reset();
+    u8 id;
+    for (int t = 0; t < 5; t++) {
+        id = 0;
+        axs_i2c_read_reg(CST_ADDR_7BIT, CST_REG_CHIPID, &id, 1);
+        printf("cst816d: ID try%d = 0x%02x\n", t, id);
+        if (id) { printf("cst816d: OK (id 0x%02x)\n", id); return 0; }
+        os_time_dly(10);
+    }
+    printf("cst816d: no response (check RST PA2 / power / addr 0x15)\n");
+    return -1;
+}
+static int cst816d_read(u16 *px, u16 *py)
+{
+    u8 d[6] = {0};
+    if (axs_i2c_read_reg(CST_ADDR_7BIT, CST_REG_TOUCH, d, 6) != 6) {
+        return 0;
+    }
+    u8 fingers = d[1] & 0x0F;
+    if (fingers != 1) {
+        return 0;
+    }
+    *px = ((u16)(d[2] & 0x0F) << 8) | d[3];
+    *py = ((u16)(d[4] & 0x0F) << 8) | d[5];
+    return 1;
+}
+
+/* Per-board touch selector: badge 2 (BADGE2 panel) = CST816D, badge 1 (ST77916) = AXS5106L. */
+#if (defined TCFG_LCD_SPI_BADGE2_ENABLE && TCFG_LCD_SPI_BADGE2_ENABLE)
+#define badge_tp_init  cst816d_init
+#define badge_tp_read  cst816d_read
+#else
+#define badge_tp_init  axs5106l_init
+#define badge_tp_read  axs5106l_read
+#endif
+
+static void axs_draw_dot(struct lcd_interface *lcd, u16 cx, u16 cy, u32 color, u16 w, u16 h)
+{
+    const int R = 4;
+    int x0 = (cx > R) ? cx - R : 0;
+    int y0 = (cy > R) ? cy - R : 0;
+    int x1 = (cx + R < w) ? cx + R : w - 1;
+    int y1 = (cy + R < h) ? cy + R : h - 1;
+    x0 &= ~1; y0 &= ~1; x1 |= 1; y1 |= 1;        /* align to 2 (driver addr alignment) */
+    if (x1 > w - 1) { x1 = w - 1; }
+    if (y1 > h - 1) { y1 = h - 1; }
+    if (lcd->clear_screen) {
+        lcd->clear_screen(color, x0, x1, y0, y1);
+    }
+}
+
+/* Everything inlined into the task (no helpers, no gpu_ready flag) so LTO keeps
+ * the whole colors+image path — lcd_test_task is kept (task_create takes its address),
+ * and now references the image push directly. */
+static void lcd_test_task(void *priv)
+{
+    struct lcd_interface *lcd = lcd_get_hdl();
+    if (!lcd) {
+        printf("lcd_test: no lcd handle\n");
+        return;
+    }
+    if (lcd->init) {
+        lcd->init((void *)&ui_cfg_data);
+    }
+
+    struct lcd_info info = {0};
+    if (lcd->get_screen_info) {
+        lcd->get_screen_info(&info);
+    }
+    u16 w = info.width  ? info.width  : 360;
+    u16 h = info.height ? info.height : 360;
+    printf("lcd_test: %d x %d\n", w, h);
+
+    /* GPU/DBI init needed by the block image push (same as gpio_demo). */
+    mem_var_init(3 * 1024, false);
+    jlgpu_module_init(lcd_test_gpu_malloc, lcd_test_gpu_free, w, h);
+
+    if (lcd->backlight_ctrl) {
+        lcd->backlight_ctrl(100);
+    }
+
+    /* solid colors */
+    static const u32 lcd_test_colors[3] = {0x00FF00, 0xFF0000, 0x0000FF};
+    static const char *const lcd_test_names[3] = {"green", "red", "blue"};
+    for (int i = 0; i < 3; i++) {
+        printf("lcd_test: color %s\n", lcd_test_names[i]);
+        if (lcd->clear_screen) {
+            lcd->clear_screen(lcd_test_colors[i], 0, w - 1, 0, h - 1);
+        }
+        os_time_dly(100);   /* 1 s */
+    }
+
+    /* cat: pushes the RGB565 image in horizontal blocks via the DBI.
+     * The menu build drops the 253 KB image to fit within the app.bin size budget for BLE OTA. */
+#if !defined(CONFIG_BADGE_MENU) || defined(CONFIG_CAT)
+    printf("lcd_test: cat %dx%d\n", GATITO_W, GATITO_H);
+    {
+        int stride = GATITO_W * 2;
+        lcd_set_draw_area(0, GATITO_W - 1, 0, GATITO_H - 1);
+        int y = 0, first = 1;
+        while (y < GATITO_H) {
+            int rows = (y + LCD_TEST_BLOCK_ROWS <= GATITO_H) ? LCD_TEST_BLOCK_ROWS : (GATITO_H - y);
+#ifdef CONFIG_CAT
+            tzflash_read(lcd_test_block_buf, (u32)rows * stride, GATITO_FLASH_ADDR + (u32)y * stride);
+#else
+            memcpy(lcd_test_block_buf, (const u8 *)gatito_logo + (u32)y * stride, (u32)rows * stride);
+#endif
+            if (first) {
+                lcd_draw_kistart(lcd_test_block_buf, 0, GATITO_W - 1, y, y + rows - 1);
+                first = 0;
+            } else {
+                lcd_draw_continue(lcd_test_block_buf, 0, GATITO_W - 1, y, y + rows - 1);
+            }
+            lcd_wait_busy();
+            y += rows;
+        }
+        lcd_wait_busy();
+    }
+#endif
+
+    /* touch: brings up the AXS5106L and, on each touch, draws a yellow dot at the
+     * reported coordinate and prints it over the UART. */
+    if (axs5106l_init() == 0) {
+        printf("lcd_test: touch ready — draw dots on touch\n");
+        u16 tx, ty;
+        while (1) {
+            if (axs5106l_read(&tx, &ty)) {
+                printf("touch: %d, %d\n", tx, ty);
+                axs_draw_dot(lcd, tx, ty, 0xFFFF00, w, h);
+            }
+            os_time_dly(2);   /* poll every ~20 ms */
+        }
+    }
+
+    while (1) {
+        os_time_dly(100);
+    }
+}
+
+#ifdef CONFIG_BADGE_MENU
+/* R3 touch for the LVGL menu: serves lv_port_indev's get_touch_x_y_status() from the
+ * badge's real AXS5106L (the CST816D driver is disabled — it floods iic0 + hangs).
+ * Reuses the AXS5106L bring-up that already works in lcd_test_task above. */
+/* Touch for the LVGL menu. axs_poll_task does the one-time AXS5106L bring-up (axs_reset
+ * uses os_time_dly, so it needs task context) and then idles; get_touch_x_y_status()
+ * does the actual LIVE sampling (one ~1.6 ms bit-bang read with no sleeps) directly from
+ * LVGL's read_timer. Reading live removes the latency an intermediate poll/cache adds.
+ *
+ * The signature is int32_t* because this LVGL build uses a 32-bit lv_coord_t: lv_port passes
+ * (int32_t *)&data->point.x/y and we must write the FULL 32 bits. A 16-bit write left
+ * the upper half stale (Y read back as e.g. 0x10006A) so LVGL rejected the point
+ * ("Y greater than ver. res") — that broke clicks and flooded warnings every frame. */
+static volatile u8 g_axs_ready = 0;   /* touch init succeeded (set once by axs_poll_task) */
+static volatile u8 g_axs_want  = 1;   /* lock/screensaver gate: 0 = stop polling the touch (power saving) */
+
+/* Enable/disable touch polling at runtime (used by the lock/screensaver mode). This only
+ * changes the gate — it doesn't re-init the chip, so wake is instant and races nothing against
+ * axs_poll_task's one-time init (which sets g_axs_ready). */
+void badge_touch_set_enable(u8 en)
+{
+    g_axs_want = en ? 1 : 0;
+    if (en) {
+        /* The touch shares the LCD power rail (TCFG_LCD_TP_USE_SAME_PWR); suspend cut its power, so
+         * the AXS5106L lost all its state. Toggling only the gate left the touch dead after wake — the
+         * chip must be re-inited (RST pulse + boot + ID read). This runs from the wake path
+         * (badge_lock_wake, task context) with the shared rail already back on, so
+         * axs_reset's ~300ms delay is safe here. Confirmed on UART: without this, "want=1 ready=1
+         * but the read FAILS" after every wake. */
+        g_axs_ready = (badge_tp_init() == 0);
+    }
+}
+
+static void axs_poll_task(void *priv)
+{
+    (void)priv;
+    g_axs_ready = (badge_tp_init() == 0);
+    if (!g_axs_ready) {
+        printf("touch: init failed\n");
+    }
+    while (1) {
+        os_time_dly(100);
+    }
+}
+
+/* Only reads the cache that axs_poll_task keeps fresh — no I2C, no sleeps, no task
+ * creation here. This runs inside LVGL's read_timer callback, which must stay fast
+ * and non-blocking (calling axs5106l_init/os_time_dly/task_create from here is what
+ * caused the earlier intermittent touch, the hangs, and the blank-screen crash). */
+void get_touch_x_y_status(int32_t *x, int32_t *y, uint8_t *status)
+{
+    static int32_t last_x = 0, last_y = 0;
+    static u8 prev = 0;
+    u16 tx = 0, ty = 0;
+    u8 now = (g_axs_ready && g_axs_want && badge_tp_read(&tx, &ty)) ? 1 : 0;   /* gated live read */
+    if (now) {
+        last_x = tx;
+        last_y = ty;
+        *x = tx;
+        *y = ty;
+        *status = 1;
+    } else {
+        /* Released: report the last touched point (not garbage) so LVGL registers a
+         * clean release at the press location. */
+        *x = last_x;
+        *y = last_y;
+        *status = 0;
+    }
+    if (now != prev) {                  /* log DN/UP transition on PA4 */
+        prev = now;
+        printf("touch %s %d,%d\n", now ? "DN" : "UP", (int)last_x, (int)last_y);
+    }
+}
+#endif
+
+static int lcd_test_start(void)
+{
+    task_create(lcd_test_task, NULL, "lcd_test");
+    return 0;
+}
+#ifndef CONFIG_BADGE_MENU   /* MENU build: LVGL drives the LCD, not the bring-up test */
+late_initcall(lcd_test_start);
+#else
+/* MENU build: start the AXS5106L touch poll task here (safe init context), not from
+ * LVGL's read_timer callback. get_touch_x_y_status() then only reads its cache. */
+static int axs_poll_start(void)
+{
+    task_create(axs_poll_task, NULL, "axs_poll");
+    return 0;
+}
+late_initcall(axs_poll_start);
+#endif
+#endif /* TCFG_SPI_LCD_ENABLE */
 
 
 
