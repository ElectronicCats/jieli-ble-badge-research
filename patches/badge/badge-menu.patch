diff --git a/SDK/apps/common/device/key/adkey.c b/SDK/apps/common/device/key/adkey.c
index 240fc6a..27b7da8 100644
--- a/SDK/apps/common/device/key/adkey.c
+++ b/SDK/apps/common/device/key/adkey.c
@@ -17,6 +17,14 @@
 #define  TCFG_ADKEY_IR_IO_REUSE  0
 #define  TCFG_ADKEY_LED_SPI_IO_REUSE  0
 
+/* ===========================================================================
+ * BADGE FIRMWARE VERSION  ->  BUMP THIS STRING ON EVERY OTA TEST BUILD.
+ * Pressing button 1 prints it over the debug UART, so after an OTA you can
+ * press button 1 and confirm the new firmware is running (e.g. "version 1"
+ * before, "version 2" after the OTA is applied).
+ * =========================================================================== */
+#define BADGE_FW_VERSION_STR   "dev"
+
 static const struct adkey_platform_data *__this = NULL;
 
 //按键驱动扫描参数列表
@@ -39,13 +47,132 @@ u8 ad_get_key_value(void)
         return NO_KEY;
     }
 
-    /* ad_data = adc_get_voltage(__this->ad_channel); */
+#if (defined TCFG_LCD_SPI_BADGE2_ENABLE && TCFG_LCD_SPI_BADGE2_ENABLE)
+    /* badge2: PB7 is read through the PMU PADC0 path (AD_CH_IO_PB7 == AD_CH_PMU_PADC0),
+     * which the round-robin sampler updates too slowly to catch presses (adc_get_value
+     * returned a stale ~4040). Force a FRESH blocking sample on each 10ms scan so a press
+     * (PB7 pulled low -> ~40) is caught reliably. */
+    ad_data = adc_get_value_blocking(__this->ad_channel);
+#else
     ad_data = adc_get_value(__this->ad_channel);
-    for (i = 0; i < CONFIG_ADKEY_MAX_NUM; i++) {
-        if ((ad_data <= __this->ad_value[i]) && (__this->ad_value[i] < 0xfffL)) {
-            return __this->key_value[i];
+#endif
+
+    /* diag: PB7 is a P33 WAKEUP port; its level (P3_WKUP_LEVEL0 bit1) and the latched edge (P3_WKUP_N_PND0 bit1) are the P33 domain that gpio_read/ADC never saw. Prints on any change. */
+    {
+        static u32 llvl = 0xffffffff, lpnd = 0xffffffff;
+        u32 lvl = P33_CON_GET(P3_WKUP_LEVEL0);
+        u32 pnd = P33_CON_GET(P3_WKUP_N_PND0);
+        if (lvl != llvl || pnd != lpnd) {
+            llvl = lvl; lpnd = pnd;
+            printf("[WKUP] level=%x npnd=%x (PB7=bit1)\n", lvl, pnd);
+        }
+    }
+
+    /* badge: the hand-wired buttons have flaky contact. While a button is held,
+     * imperfect contact raises the divider resistance, so the AD sweeps UP from
+     * the button's real level through the upper windows (a pressed button 1 read
+     * wrongly as button 2). Contact can only RAISE the AD, never pull it below the
+     * button's resistance floor -> classify by the MINIMUM AD seen during the press.
+     * A brief release debounce keeps short upward bounces from clearing the minimum. */
+    /* ---- badge: robust PRESS debounce (mitigation for the flaky hand-wired PB7) ----
+     * PB7 (ADKEY resistor divider + P33 WKUP, weak 100K internal pull-up) picks up
+     * noise that falls within the buttons' AD range (~400..1800) in erratic bursts with NO
+     * real press. On badge1 the real buttons also read ~405/~737, so a single sample is
+     * indistinguishable from noise by threshold alone. What DOES separate them: a
+     * genuine press STAYS in range across many consecutive 10ms scans, whereas
+     * the observed noise bursts last ~180..230ms (~18..23 scans) then release.
+     * Classify by the MINIMUM seen during the sequence (press_min) so the upward sweep
+     * from flaky contact is still handled. Transient/erratic noise is discarded so it no longer jostles
+     * the lock/wake state machine (black screen).
+     *
+     * Duration debounce alone (BADGE_ADKEY_PRESS_DEBOUNCE, ~250ms) made real short
+     * taps feel slow. It's now only the FALLBACK: the WKUP gate below (PB7's clean
+     * digital level) confirms a physical press and commits in ~20ms, keeping fast response
+     * without reintroducing noise jostle. Scan period = 10ms (scan_time). */
+#ifndef BADGE_ADKEY_PRESS_DEBOUNCE
+#define BADGE_ADKEY_PRESS_DEBOUNCE  25   /* fallback: consecutive 10ms scans in range (~250ms) when WKUP does NOT confirm */
+#endif
+#ifndef BADGE_ADKEY_PRESS_DEBOUNCE_FAST
+#define BADGE_ADKEY_PRESS_DEBOUNCE_FAST  2   /* physical press confirmed by WKUP: commits in ~20ms */
+#endif
+    static u16 press_min   = 0xffff;   // committed press level (0xffff = released)
+    static u16 cand_min    = 0xffff;   // minimum over the current in-range sequence (uncommitted)
+    static u8  press_cnt   = 0;        // consecutive in-range samples
+    static u8  release_cnt = 0;
+    u8 kv = NO_KEY;
+
+    /* PB7 is a P33 WKUP port; its clean digital level (P3_WKUP_LEVEL0 bit1) follows the
+     * button's physical line and is immune to the ADC coupling noise that a pure threshold debounce
+     * couldn't separate from a real press. Use it as a press GATE: while PB7 is physically
+     * low the press is genuine, so COMMIT after just ..._FAST scans (~20ms) instead of the
+     * full ~250ms (which dropped real short taps -> "the buttons respond slowly"). When WKUP
+     * does NOT confirm (an AD-only dip = probably noise, or a high-AD button that stays above the
+     * WKUP threshold) fall back to the long debounce. The ADC value still CLASSIFIES which button
+     * (minimum tracking handles the upward sweep from flaky contact). Verified on UART: level=0 <=> pressed. */
+    u8 pb7_low = ((P33_CON_GET(P3_WKUP_LEVEL0) & (1u << 1)) == 0);
+    u8 need    = pb7_low ? BADGE_ADKEY_PRESS_DEBOUNCE_FAST : BADGE_ADKEY_PRESS_DEBOUNCE;
+
+    if ((ad_data > 8 && ad_data < 3600) || pb7_low) {   // AD in button range OR PB7 physically low (the AD may lag behind the WKUP edge)
+        release_cnt = 0;
+        if (ad_data > 8 && ad_data < 3600 && ad_data < cand_min) {
+            cand_min = ad_data;
+        }
+        if (press_cnt < 0xff) {
+            press_cnt++;
+        }
+        if (press_cnt >= need && cand_min != 0xffff) {
+            press_min = cand_min;      // committed press (fast if WKUP confirms, otherwise after the long debounce)
+        }
+    } else if (release_cnt < 5) {         // need ~50ms high to count as a real release
+        if (++release_cnt >= 5) {
+            press_min   = 0xffff;
+            cand_min    = 0xffff;
+            press_cnt   = 0;
+        }
+    }
+
+    if (press_min != 0xffff) {
+        for (i = 0; i < CONFIG_ADKEY_MAX_NUM; i++) {
+            if ((press_min <= __this->ad_value[i]) && (__this->ad_value[i] < 0xfffL)) {
+                kv = __this->key_value[i];
+                break;
+            }
+        }
+    }
+
+    /* badge: hand the buttons to whoever owns the UI. */
+#ifdef CONFIG_BADGE_MENU
+    /* Menu build: LVGL's keypad indev owns the buttons. Publish the raw key value so
+     * keypad_read() can poll it (same as the touch); take no action in the driver. */
+    {
+        extern volatile u8 g_badge_adkey_kv;
+        g_badge_adkey_kv = kv;
+        /* diag: log the raw AD when it moves >150 (remove once the mapping is confirmed). */
+        static u16 last_ad = 0;
+        int d = (int)ad_data - (int)last_ad;
+        if (d > 150 || d < -150) {
+            last_ad = ad_data;
+            printf("[ADKEY] raw=%d kv=%d pmin=%d\n", ad_data, kv, press_min);
+        }
+    }
+#else
+    /* Other builds: report only (edge-triggered log, no app action). */
+    {
+        static u8 last_kv = NO_KEY;
+        if (kv != last_kv) {
+            last_kv = kv;
+            if (kv == KEY_AD_NUM0) {
+                printf("[ADKEY] Button 1 pressed -- firmware %s\n", BADGE_FW_VERSION_STR);
+            } else if (kv == KEY_AD_NUM1) {
+                printf("[ADKEY] Button 2 pressed\n");
+            } else if (kv == KEY_AD_NUM2) {
+                printf("[ADKEY] Both buttons pressed\n");
+            } else {
+                printf("[ADKEY] released\n");
+            }
         }
     }
+#endif
     return NO_KEY;
 }
 
