 uint16_t bt_rcsp_custom_att_read_callback(void *hdl, hci_con_handle_t connection_handle, uint16_t att_handle, uint16_t offset, uint8_t *buffer, uint16_t buffer_size)
 {
+#ifdef CONFIG_BADGE_MENU
+    /* DIAG (remove later): trace every ATT read the host does (buffer==NULL is the
+     * stack's length-probe pass). Printed via printf so it shows on the UART regardless of
+     * the BT_BLE log-tag config. */
+    printf("badge: att_read handle=%04x off=%d %s\n", att_handle, offset, buffer ? "data" : "len");
+    /* Dynamic HID-over-GATT reads. Android's LE HID host (bta_hh_le) READS these during HID
+     * setup (input-report cache + protocol-mode probe); if the read returns nothing it
+     * aborts and the cursor never moves — this is why "pairs but does nothing" on Android
+     * while it works on Linux/BlueZ (BlueZ does not perform these reads). The static HID chars
+     * (HID Info 0x21, Report Map 0x25, PnP 0x2e, Battery 0x31) are embedded in the att-db and
+     * never reach this callback; only the DYNAMIC ones do:
+     *   0x0027 Report (input): current/idle 3-byte report {buttons, dx, dy} = zeros.
+     *   0x002b Protocol Mode: 0x01 = Report Protocol. */
+    /* The att server calls this twice: first with buffer==NULL to query the total length,
+     * then with a real buffer to copy buffer_size bytes from `offset` (same contract as the
+     * SDK's custom_att_read_callback). Returns the byte count on each call. */
+    switch (att_handle) {
+    case 0x0027: {
+        const u8 rpt[3] = {0, 0, 0};
+        if (offset >= sizeof(rpt)) {
+            return 0;
+        }
+        u16 n = sizeof(rpt) - offset;
+        if (!buffer) {
+            return n;            /* length query */
+        }
+        if (n > buffer_size) {
+            n = buffer_size;
+        }
+        memcpy(buffer, rpt + offset, n);
+        return n;
+    }
+    case 0x002b: {
+        if (offset >= 1) {
+            return 0;
+        }
+        if (!buffer) {
+            return 1;            /* length query */
+        }
+        if (buffer_size >= 1) {
+            buffer[0] = 0x01;    /* Report Protocol */
+            return 1;
+        }
+        return 0;
+    }
+    default:
+        break;
+    }
+#endif
 #if WECHAT_SPORT_ENABLE
     return bt_wechat_sport_att_read_callback(hdl, connection_handle, att_handle, offset, buffer, buffer_size);
 #endif
+    return 0;
 }
 
 
diff --git a/SDK/apps/common/third_party_profile/jieli/rcsp/qix_ota_server.c b/SDK/apps/common/third_party_profile/jieli/rcsp/qix_ota_server.c
new file mode 100644
index 0000000..d0e632e
--- /dev/null
+++ b/SDK/apps/common/third_party_profile/jieli/rcsp/qix_ota_server.c
@@ -0,0 +1,577 @@
+/*
+ * Qix OTA server over BLE (GATT service C2E6FD00) for the e_badge watch firmware.
+ *
+ * Ported from the gpio_demo Qix server (the FD00 server the qix-ble `qix flash`
+ * client talks to). Lets this firmware RECEIVE + APPLY a Qix OTA over BLE — a
+ * single-pass, app-only OTA flow (a ~1 MB app-only image; the UI resources ship
+ * from the factory and are never sent over OTA).
+ *
+ * Hooks into the existing RCSP/btstack GATT server:
+ *   - FD00/FD01/FD02/FD03 are added to rcsp_profile_data[] (multi_protocol_main.c)
+ *     at handles 0x0016..0x001e.
+ *   - Writes to FD02 are routed here from bt_rcsp_custom_att_write_callback().
+ *   - FD01 notifications go out via ble_op_att_send_data() (forced ATT_OP_NOTIFY).
+ *
+ * Wire protocol (Qix):
+ *   frame = [0x9E][cksum][flags][cmd][len LE16][payload], cksum = sum(bytes[2:]) & 0xFF
+ *   OTA:  0xC0 REQ_UPDATE -> 0xC1 RET_UPDATE [state, allow BE32, off BE32]
+ *         0xC2 SEND_DATA  -> 0xC3 RET_DATA   [state, next_off LE32]
+ *               SEND_DATA payload = [chunk_size LE32][offset LE32][data...]
+ *         final           -> 0xC5 RET_RESULT [status]
+ *
+ * The Qix payload is the raw JieLi .ufw (the 27-byte Qix wrapper rides in
+ * REQ_UPDATE, not in the data stream). It is streamed to the dual_bank
+ * passive-update backend (the same backend the RCSP OTA uses: writes a staging
+ * area, the loader does the swap on reboot). A passive update needs free flash
+ * >= payload size, so the payload must be app-only (~1 MB) — a full 2.5 MB
+ * app+resources image does NOT fit.
+ *
+ * Two safety gates:
+ *   QIX_OTA_APPLY  -> write staging + verify (non-destructive: the running fw
+ *                     is left intact).
+ *   QIX_OTA_COMMIT -> burn_boot_info + reboot (POINT OF NO RETURN).
+ * With QIX_OTA_COMMIT 0 it runs the whole write+verify path but the badge keeps
+ * running its current firmware — impossible to brick. Set to 1 for the real apply.
+ */
+#include "system/includes.h"
+#include "app_config.h"     /* CONFIG_DOUBLE_BANK_ENABLE, TCFG_COMPELTE_UFW_LC_EN, CONFIG_BADGE_MENU */
+#include "btstack/le/att.h"
+#include "btstack/le/ble_api.h"
+#include "btstack/bluetooth.h"
+#include "dual_bank_updata_api.h"
+
+/* Use plain printf (JieLi's LOG_TAG_CONST mechanism needs the tag registered in the
+ * log config; printf sidesteps that and works just like the [ADKEY] bring-up prints). */
+#define qix_log(fmt, ...)   printf("[QIX] " fmt "\n", ##__VA_ARGS__)
+
+/* ---- Safety gates ---- */
+#define QIX_OTA_APPLY    1   /* 1 = write the received UFW to staging in flash + verify */
+#define QIX_OTA_COMMIT   1
+#define QIX_OTA_FORCE_COMMIT 0   /* 1 = burn boot info + reboot even if verify fails. PROVEN DEAD END
+                                for a foreign-geometry image: burn_boot succeeds but uboot's own jl_file_head_valid_check
+                                rejects the foreign-geometry bank on reboot → dual-bank fallback to our fw.
+                                Leave at 0 (irreversible + useless for cross-geometry). */
+
+/* Single-bank apply: on a single-bank geometry (CONFIG_DOUBLE_BANK_ENABLE=0),
+ * dual_bank_passive_update_init cannot init (the running app_dir has no
+ * app_dir_head2 -> update_init r=-3). Instead, stage the incoming .ufw raw and
+ * hand it to the resident uboot's single-bank lc_flash path (same as the 0xD4
+ * RAW_APPLY command). The incoming image is app-only and self-consistent with the
+ * single-bank geometry, so the resident uboot writes the code partition on next boot. */
+#if (QIX_OTA_APPLY && defined(CONFIG_BADGE_MENU) && TCFG_COMPELTE_UFW_LC_EN && !CONFIG_DOUBLE_BANK_ENABLE)
+#define QIX_OTA_STAGE_SINGLE_BANK  1
+#define QIX_STAGE_BASE    0x17E000u   /* free raw region [0x17E000,0x3BE000): SDFILE+VIRFAT as scratch */
+#define QIX_STAGE_END     0x3BE000u
+#define QIX_ERASE_SECTOR_CMD  200     /* IOCTL_ERASE_SECTOR (matches qix_raw_flash.c) */
+extern int  tzflash_write(const void *buf, u32 len, u32 offset);
+extern int  tzflash_ioctl(u32 cmd, u32 arg);
+extern int  qix_stage_apply(u32 addr, u32 len);
+extern void wdt_clear(void);
+#else
+#define QIX_OTA_STAGE_SINGLE_BANK  0
+#endif
+
+/* ATT value handles within rcsp_profile_data[] (keep in sync with the att-db). */
+#define QIX_FD01_VAL_HANDLE   0x0018   /* NOTIFY (TX to client); CCC at +1 = 0x0019 */
+#define QIX_FD02_VAL_HANDLE   0x001b   /* WRITE (RX from client) */
+#define QIX_FD03_VAL_HANDLE   0x001d   /* NOTIFY (ctrl); CCC at +1 = 0x001e */
+
+/* Qix OTA opcodes */
+#define QIX_CMD_REQ_UPDATE        0xC0
+#define QIX_CMD_RET_UPDATE        0xC1
+#define QIX_CMD_SEND_UPDATE_DATA  0xC2
+#define QIX_CMD_RET_UPDATE_DATA   0xC3
+#define QIX_CMD_RET_UPDATE_RESULT 0xC5
+
+/* allow_len we announce. Each Qix data chunk stays within this. */
+#define QIX_ALLOW_LEN   1024  /* matches ble_fmy_ota's OTA_WRITE_FLASH_SIZE: dual_bank_update_write rejects sub-block writes (244B) with -1 */
+#define QIX_MAX_PKT     1024  /* max_pkt_len from the dual_bank init; must match the write block size */
+
+#if QIX_OTA_APPLY
+/* In update.a but not in the public header (matches ble_fmy_ota.c). Returns 0 == verify OK. */
+extern u8   dual_bank_update_verify_without_crc(int (*verify_result_hdl)(int calc_crc));
+extern void set_ota_status(u8 stu);
+#endif
+
+/* ble_op_att_send_data() is a MACRO in btstack/le/ble_api.h (wraps ble_user_cmd_prepare) —
+ * don't re-declare it; just call it. */
+
+/* ---- BLE HID mouse (HOGP) ---------------------------------------------
+ * The HID service is in rcsp_profile_data[] (handles 0x001f-0x002b). The 3-byte input
+ * report {buttons, dx, dy} is sent on the Report value handle 0x0027. The ATT operation
+ * type (NOTIFY vs INDICATE) is chosen from what the host wrote to the Report's CCCD at
+ * 0x0028: 0x0001 = NOTIFY, 0x0002 = INDICATE. iOS Core Bluetooth subscribes to HID input
+ * reports with INDICATE on several builds and silently drops the report if the peripheral
+ * emits NOTIFY; Android/BlueZ accept both. Default to NOTIFY when no client has subscribed
+ * yet (preserves the earlier behavior, harmless: no subscriber, no delivery). Called from
+ * the LVGL trackpad (mouse_send). dx/dy are clamped to HID's signed 8-bit range. */
+#define HID_REPORT_VAL_HANDLE       0x0027
+#define HID_REPORT_CCC_HANDLE      0x0028
+/* 0 = none/off, 0x0001 = NOTIFY, 0x0002 = INDICATE. Set by the ATT write callback when the
+ * host configures the Report's CCCD. Read here to choose the ATT_OP for each report. */
+static volatile u16 g_hid_report_ccc;
+
+void ble_hid_report_ccc_set(u16 ccc_value)
+{
+    g_hid_report_ccc = ccc_value;
+}
+
+void ble_hid_mouse_report(int buttons, int dx, int dy)
+{
+    if (dx > 127)  { dx = 127; }
+    if (dx < -127) { dx = -127; }
+    if (dy > 127)  { dy = 127; }
+    if (dy < -127) { dy = -127; }
+    u8 rpt[3];
+    rpt[0] = (u8)(buttons & 0x07);
+    rpt[1] = (u8)(s8)dx;
+    rpt[2] = (u8)(s8)dy;
+    /* Choose NOTIFY/INDICATE per the CCC the host set (see the section header);
+     * iOS needs INDICATE. Default to NOTIFY if no host configured the CCC. */
+    u8 op = ATT_OP_NOTIFY;
+    if (g_hid_report_ccc & 0x0002) {
+        op = ATT_OP_INDICATE;
+    }
+    ble_op_att_send_data(HID_REPORT_VAL_HANDLE, rpt, 3, op);
+}
+
+/* ---- OTA receive state ---- */
+static u8  qix_ota_active = 0;
+static u32 qix_ota_total  = 0;   /* payload size from REQ_UPDATE header27[13:17] LE32 */
+static u32 qix_ota_offset = 0;   /* bytes received/written so far */
+
+#if QIX_OTA_APPLY
+static u8           qix_apply_inited  = 0;  /* dual_bank_passive_update_init succeeded */
+static volatile u8  qix_write_pending = 0;  /* a dual_bank_update_write is draining */
+static volatile int qix_write_err     = 0;  /* err reported by the write-complete cb */
+#endif
+
+/* Streaming RX buffer to reassemble Qix frames from the FD02 writes. */
+static u8  qix_rx_buf[1100];  /* holds one 1024B chunk frame (6 hdr + 8 chunk-hdr + 1024) */
+static u16 qix_rx_len = 0;
+/* dual_bank_update_write DMAs from this buffer to flash — the source MUST be 4-byte
+ * aligned (a pointer inside qix_rx_buf lands at +14, misaligned → flash write error
+ * err=-1). Copy each chunk here first, exactly like ble_fmy_ota.c's fmy_ota->buff. */
+static u8  qix_wbuf[1024 + 32] __attribute__((aligned(4)));
+
+#if QIX_OTA_APPLY
+static void qix_apply_cleanup(void)
+{
+    if (qix_apply_inited) {
+        dual_bank_passive_update_exit(NULL);
+        qix_apply_inited = 0;
+    }
+    set_ota_status(0);
+}
+#endif
+
+void qix_ota_server_on_connect(void)
+{
+    qix_rx_len = 0;
+    qix_ota_active = 0;
+    qix_ota_offset = 0;
+#if QIX_OTA_APPLY
+    qix_apply_inited = 0;
+#endif
+    qix_log("connect: OTA state reset");
+}
+
+void qix_ota_server_on_disconnect(void)
+{
+    qix_rx_len = 0;
+    qix_ota_active = 0;
+#if QIX_OTA_APPLY
+    qix_apply_cleanup();   /* discard any half-written staging if the link dropped mid-OTA */
+#endif
+}
+
+/* Send a Qix frame via FD01 notify. cksum = sum(flags,cmd,len_lo,len_hi,payload) & 0xFF.
+ * Forces ATT_OP_NOTIFY (not ATT_OP_AUTO_READ_CCC): we don't manage FD01's CCC config
+ * ourselves, so AUTO_READ_CCC sees it disabled and returns -93. The client subscribes to
+ * FD01 (its CCC write arrives as att_handle 0x0019), so a forced notify reaches it fine. */
+static void qix_send_frame(u8 cmd, const u8 *payload, u16 plen)
+{
+    u8 f[6 + 32];
+    if (plen > sizeof(f) - 6) {
+        return;
+    }
+    f[0] = 0x9E;
+    f[2] = 0x00;            /* flags */
+    f[3] = cmd;
+    f[4] = plen & 0xFF;
+    f[5] = (plen >> 8) & 0xFF;
+    if (plen) {
+        memcpy(&f[6], payload, plen);
+    }
+    u32 sum = 0;
+    for (u16 i = 2; i < 6 + plen; i++) {
+        sum += f[i];
+    }
+    f[1] = sum & 0xFF;
+
+    int r = ble_op_att_send_data(QIX_FD01_VAL_HANDLE, f, 6 + plen, ATT_OP_NOTIFY);
+    if (r) {
+        qix_log("notify cmd=0x%02x fail r=%d", cmd, r);
+    }
+}
+
+#if QIX_OTA_APPLY
+/* dual_bank_update_write completion: priv carries the error code. */
+static int qix_write_complete_cb(void *priv)
+{
+    qix_write_err = (int)priv;
+    qix_write_pending = 0;
+    return 0;
+}
+
+/* Verify "resume" hook (called by the backend during verify; no-op like fmy). */
+static int qix_verify_resume_cb(int calc_crc)
+{
+    return 0;
+}
+#endif
+
+#if (QIX_OTA_APPLY && QIX_OTA_COMMIT)
+static void qix_reboot_cb(void *priv)
+{
+    qix_log("rebooting to apply OTA");
+    cpu_reset();
+}
+
+static int qix_boot_info_cb(int err)
+{
+    qix_log("burn_boot_info err=%d", err);
+    if (err == 0) {
+        qix_log("*** OTA APPLIED — reboot in 2s ***");
+        sys_timeout_add(NULL, qix_reboot_cb, 2000);
+    } else {
+        qix_log("burn_boot_info FAILED — staying on current firmware");
+    }
+    return 0;
+}
+#endif
+
+/* Send RET_UPDATE [state][allow_len BE32][offset BE32]. state=1 accept, 0 reject. */
+static void qix_send_ret_update(u8 state)
+{
+    u8 resp[9];
+    resp[0] = state;
+    if (state) {
+        resp[1] = (QIX_ALLOW_LEN >> 24) & 0xFF; resp[2] = (QIX_ALLOW_LEN >> 16) & 0xFF;
+        resp[3] = (QIX_ALLOW_LEN >> 8) & 0xFF;  resp[4] = QIX_ALLOW_LEN & 0xFF;
+    } else {
+        resp[1] = resp[2] = resp[3] = resp[4] = 0;
+    }
+    resp[5] = resp[6] = resp[7] = resp[8] = 0;
+    qix_send_frame(QIX_CMD_RET_UPDATE, resp, 9);
+}
+
+/* Send RET_UPDATE_DATA [state][next_offset LE32]. state=0 ok, !=0 -> the client aborts. */
+static void qix_send_ret_data(u8 state, u32 next_off)
+{
+    u8 ack[5];
+    ack[0] = state;
+    ack[1] = next_off & 0xFF;         ack[2] = (next_off >> 8) & 0xFF;
+    ack[3] = (next_off >> 16) & 0xFF; ack[4] = (next_off >> 24) & 0xFF;
+    qix_send_frame(QIX_CMD_RET_UPDATE_DATA, ack, 5);
+}
+
+/* Dispatch a complete, validated Qix frame. */
+static void qix_handle_frame(u8 cmd, const u8 *p, u16 plen)
+{
+#ifdef CONFIG_BADGE_MENU
+    /* Raw-flash extension (erase/write/read/reboot of any partition + BLE lock of the
+     * Update screen). Handles 0xD0..0xD4; returns 1 when the frame belongs to it. */
+    extern int qix_raw_flash_handle(u8 cmd, const u8 *p, u16 plen);
+    if (qix_raw_flash_handle(cmd, p, plen)) {
+        return;
+    }
+#endif
+
+    /* --- Recognition/query probe a companion app emits right after connecting (FD02 write
+     * -> FD01 notify). The app classifies a device ONLY from these replies; without them the
+     * device stays silent and never shows up in the app (advertising alone isn't enough). The
+     * replies carry device/version info so it lists the device and offers an update:
+     * 0x60 REQ_BIND -> 0x61 RET_BIND (proto "2.7" + fw + PID), 0xC6 REQ_BADGE_INFO ->
+     * 0xC7 REP_BADGE_INFO (screen 360x360 / image 368x368 + mem). */
+    if (cmd == 0x60) {   /* REQ_BIND -> 0x61 RET_BIND */
+        static const u8 bind[] = {
+            0x00, '2', '.', '7',
+            /* firmwaVersion reported to the app. Kept at 8 chars so the binary tail below stays
+             * byte-aligned, but LOW so the app treats the device as out of date and offers the
+             * update instead of "already up to date". */
+            '0', '1', '.', '0', '.', '0', '.', '0', 0x00, 0x00,
+            0x00, 0x16, 0x06, 0x00, 0x80, 0x10, 0x40, 0x01, 0x00, 0x00, 0x20,
+            '1', '.', '0', '.', '0',
+        };
+        qix_send_frame(0x61, bind, sizeof(bind));
+        return;
+    }
+    if (cmd == 0xC6) {   /* REQ_BADGE_INFO -> 0xC7 REP_BADGE_INFO */
+        static const u8 info[] = {
+            0x01,                   /* valid */
+            0x68, 0x01, 0x68, 0x01, /* screen 360 x 360 */
+            0x70, 0x01, 0x70, 0x01, /* image  368 x 368 */
+            0x1C, 0x08, 0x00, 0x00, /* free memory (KB) */
+        };
+        qix_send_frame(0xC7, info, sizeof(info));
+        return;
+    }
+    if (cmd == 0x29) {   /* battery bootstrap trigger -> push 0x27 BATTERY_DATA */
+        /* The companion app reads the battery ONLY from this device push, NOT from 0x180F/2A19
+         * (which it treats as empty) nor from RCSP's sys_info (bogus 0x00). It writes
+         * FD02 `9E .. 29 01 00 80` and expects an FD01 notify cmd 0x27 with [charge_mode, percent].
+         * Without it, the app keeps a stale/cached level and blocks the OTA for "low battery".
+         * Report the real ADC percentage. */
+        extern u8 get_vbat_percent(void);
+        u8 bat[2] = { 0x00, get_vbat_percent() };   /* [0]=discharging, [1]=percent 0..100 */
+        qix_log("battery push -> %u%%", bat[1]);
+        qix_send_frame(0x27, bat, sizeof(bat));
+        return;
+    }
+
+    if (cmd == QIX_CMD_REQ_UPDATE) {
+        if (plen < 17) {
+            qix_log("REQ_UPDATE short (%d)", plen);
+            return;
+        }
+        qix_ota_total  = p[13] | (p[14] << 8) | (p[15] << 16) | ((u32)p[16] << 24);
+        qix_ota_offset = 0;
+
+#if QIX_OTA_STAGE_SINGLE_BANK
+        /* Erase the raw staging span, then stream the chunks into it (0xC2). */
+        if (!qix_ota_total || QIX_STAGE_BASE + qix_ota_total > QIX_STAGE_END) {
+            qix_log("REQ_UPDATE: %u bytes won't fit staging [0x%x,0x%x) — reject",
+                    qix_ota_total, QIX_STAGE_BASE, QIX_STAGE_END);
+            qix_ota_active = 0;
+            qix_send_ret_update(0);
+            return;
+        }
+        set_ota_status(1);
+        for (u32 a = QIX_STAGE_BASE; a < QIX_STAGE_BASE + qix_ota_total; a += 0x1000) {
+            wdt_clear();
+            if (tzflash_ioctl(QIX_ERASE_SECTOR_CMD, a) != 0) {
+                qix_log("REQ_UPDATE: stage erase @0x%x fail — reject", a);
+                set_ota_status(0);
+                qix_ota_active = 0;
+                qix_send_ret_update(0);
+                return;
+            }
+        }
+        qix_apply_inited = 1;   /* reuse the flag as "staging armed" */
+#elif QIX_OTA_APPLY
+        dual_bank_passive_update_exit(NULL);   /* clear any stale update state */
+        set_ota_status(1);
+        u32 ir = dual_bank_passive_update_init(0, qix_ota_total, QIX_MAX_PKT, NULL);
+        if (ir != 0) {
+            qix_log("REQ_UPDATE: update_init fail r=%u — reject", ir);
+            set_ota_status(0);
+            qix_ota_active = 0;
+            qix_send_ret_update(0);
+            return;
+        }
+        qix_apply_inited = 1;
+        u32 cr = dual_bank_update_allow_check(qix_ota_total);
+        if (cr != 0) {
+            qix_log("REQ_UPDATE: allow_check fail r=%u for %u bytes (won't fit staging) — reject",
+                    cr, qix_ota_total);
+            qix_apply_cleanup();
+            qix_ota_active = 0;
+            qix_send_ret_update(0);
+            return;
+        }
+#endif
+        qix_ota_active = 1;
+        qix_log("REQ_UPDATE -> total=%u bytes, accept (allow=%d) [%s]", qix_ota_total,
+                QIX_ALLOW_LEN, QIX_OTA_COMMIT ? "APPLY+COMMIT" : (QIX_OTA_APPLY ? "APPLY dry-run" : "phase1"));
+        qix_send_ret_update(1);
+        return;
+    }
+
+    if (cmd == QIX_CMD_SEND_UPDATE_DATA) {
+        if (!qix_ota_active || plen < 8) {
+            return;
+        }
+        u32 chunk_size = p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24);
+        u32 chunk_off  = p[4] | (p[5] << 8) | (p[6] << 16) | ((u32)p[7] << 24);
+        u32 dlen = plen - 8;
+        const u8 *data = p + 8;
+
+        /* Safety: the declared chunk_size must match the actual data, and the chunk offset
+         * must be exactly where we are — dual_bank writes to flash sequentially, so an
+         * out-of-order chunk or a mismatched size would corrupt the image. */
+        if (chunk_size != dlen || chunk_off != qix_ota_offset) {
+            qix_log("SEND_DATA bad: size=%u dlen=%u off=%u expect=%u — abort",
+                    chunk_size, dlen, chunk_off, qix_ota_offset);
+#if QIX_OTA_APPLY
+            qix_apply_cleanup();
+#endif
+            qix_ota_active = 0;
+            qix_send_ret_data(1, qix_ota_offset);
+            return;
+        }
+
+#if QIX_OTA_STAGE_SINGLE_BANK
+        wdt_clear();
+        /* tzflash_write handles a misaligned source (like qix_raw_flash's RAW_WRITE). */
+        if (tzflash_write(data, dlen, QIX_STAGE_BASE + qix_ota_offset) < 0) {
+            qix_log("stage write @0x%x len=%u fail — abort",
+                    QIX_STAGE_BASE + qix_ota_offset, dlen);
+            qix_apply_cleanup();
+            qix_ota_active = 0;
+            qix_send_ret_data(1, qix_ota_offset);
+            return;
+        }
+#elif QIX_OTA_APPLY
+        qix_write_pending = 1;
+        qix_write_err = 0;
+        /* Copy to the aligned buffer — dual_bank_update_write's DMA to flash needs a
+         * 4-byte-aligned source; `data` (=qix_rx_buf+14) is misaligned → err=-1. */
+        memcpy(qix_wbuf, data, dlen);
+        u32 wr = dual_bank_update_write((void *)qix_wbuf, (u16)dlen, qix_write_complete_cb);
+        if (wr != 0) {
+            qix_log("dual_bank_update_write reject r=%u @ off=%u — abort", wr, qix_ota_offset);
+            qix_apply_cleanup();
+            qix_ota_active = 0;
+            qix_send_ret_data(1, qix_ota_offset);
+            return;
+        }
+        /* Wait for the flash write to drain before ACKing. The client is strictly
+         * request/response, so this serializes to one chunk in flight. We run in the
+         * btstack task; os_time_dly yields, the update task does the write + fires the cb. */
+        int wait = 3000;
+        while (qix_write_pending && wait-- > 0) {
+            os_time_dly(1);
+        }
+        if (qix_write_pending || qix_write_err) {
+            qix_log("flash write %s (err=%d) @ off=%u — abort",
+                    qix_write_pending ? "timeout" : "error", qix_write_err, qix_ota_offset);
+            qix_apply_cleanup();
+            qix_ota_active = 0;
+            qix_send_ret_data(1, qix_ota_offset);
+            return;
+        }
+#endif
+
+        qix_ota_offset += dlen;
+        if ((qix_ota_offset & 0x3FFF) < dlen) {   /* log ~every 16KB */
+            qix_log("OTA %u / %u (%u%%)", qix_ota_offset, qix_ota_total,
+                    qix_ota_total ? (qix_ota_offset * 100 / qix_ota_total) : 0);
+        }
+        qix_send_ret_data(0, qix_ota_offset);
+
+        if (qix_ota_total && qix_ota_offset >= qix_ota_total) {
+#if QIX_OTA_STAGE_SINGLE_BANK
+            qix_log("OTA fully received (%u bytes) — single-bank apply via uboot", qix_ota_offset);
+            qix_apply_inited = 0;
+            int ar = qix_stage_apply(QIX_STAGE_BASE, qix_ota_total);
+            {
+                u8 res = (ar == 0) ? 0 : 1;
+                qix_send_frame(QIX_CMD_RET_UPDATE_RESULT, &res, 1);
+            }
+            if (ar != 0) {
+                qix_log("stage apply fail r=%d — staying on current fw", ar);
+                set_ota_status(0);
+            }
+            /* on success the apply task verifies + resets to the resident uboot, which
+             * writes the code partition; the RET_RESULT above is best-effort before the
+             * reset. */
+            qix_ota_active = 0;
+            return;
+#elif QIX_OTA_APPLY
+            qix_log("OTA fully received (%u bytes) — verifying", qix_ota_offset);
+            u8 vr = dual_bank_update_verify_without_crc(qix_verify_resume_cb);
+            if (vr == 0) {
+#if QIX_OTA_COMMIT
+                qix_log("verify OK — committing boot info + reboot");
+                u8 res = 0;
+                qix_send_frame(QIX_CMD_RET_UPDATE_RESULT, &res, 1);
+                qix_apply_inited = 0;   /* ownership passes to burn/boot */
+                set_ota_status(0);
+                dual_bank_update_burn_boot_info(qix_boot_info_cb);   /* reboots in the cb */
+#else
+                qix_log("*** verify OK — DRY-RUN, NOT committing (badge keeps current fw) ***");
+                u8 res = 0;
+                qix_send_frame(QIX_CMD_RET_UPDATE_RESULT, &res, 1);
+                qix_apply_cleanup();
+#endif
+            } else {
+#if (QIX_OTA_COMMIT && QIX_OTA_FORCE_COMMIT)
+                /* TEST: the structural verify (file-head / app_dir crc) fails when we raw-write
+                 * a foreign app that the shared file-head doesn't describe, but the app CONTENT
+                 * is fully written. Commit anyway to see if the bank boots. */
+                qix_log("verify FAIL r=%u — FORCE-committing anyway (test)", vr);
+                u8 res = 0;
+                qix_send_frame(QIX_CMD_RET_UPDATE_RESULT, &res, 1);
+                qix_apply_inited = 0;
+                set_ota_status(0);
+                dual_bank_update_burn_boot_info(qix_boot_info_cb);
+#else
+                qix_log("verify FAIL r=%u — NOT applying", vr);
+                u8 res = 1;
+                qix_send_frame(QIX_CMD_RET_UPDATE_RESULT, &res, 1);
+                qix_apply_cleanup();
+#endif
+            }
+#else
+            qix_log("*** OTA RECEIVED COMPLETE (%u bytes) — NOT applied (Phase 1) ***",
+                    qix_ota_offset);
+            u8 res = 0;  /* status 0 = OK */
+            qix_send_frame(QIX_CMD_RET_UPDATE_RESULT, &res, 1);
+#endif
+            qix_ota_active = 0;
+        }
+        return;
+    }
+
+    /* Any other command: never stay silent. Unhandled probes get a benign status frame
+     * 0xFF [opcode][0x00]; the app's recognition dialog tolerates it (it just means
+     * "optional command not supported") but total silence makes it discard the device. */
+    {
+        u8 err[2] = { cmd, 0x00 };
+        qix_send_frame(0xFF, err, sizeof(err));
+    }
+}
+
+/* Accumulate the FD02 write bytes and extract complete Qix frames from the stream. */
+void qix_ota_server_rx_feed(const u8 *data, u16 len)
+{
+    if (qix_rx_len + len > sizeof(qix_rx_buf)) {
+        qix_rx_len = 0;  /* overflow: discard (resync) */
+    }
+    memcpy(&qix_rx_buf[qix_rx_len], data, len);
+    qix_rx_len += len;
+
+    u16 i = 0;
+    while (1) {
+        while (i < qix_rx_len && qix_rx_buf[i] != 0x9E) {
+            i++;
+        }
+        if (i >= qix_rx_len) {
+            qix_rx_len = 0;
+            return;
+        }
+        if ((u16)(qix_rx_len - i) < 6) {
+            break;                                  /* incomplete header */
+        }
+        u16 plen = qix_rx_buf[i + 4] | (qix_rx_buf[i + 5] << 8);
+        u16 total = 6 + plen;
+        if ((u16)(qix_rx_len - i) < total) {
+            break;                                  /* incomplete payload */
+        }
+        u32 sum = 0;
+        for (u16 k = i + 2; k < i + total; k++) {
+            sum += qix_rx_buf[k];
+        }
+        if ((sum & 0xFF) == qix_rx_buf[i + 1]) {
+            qix_handle_frame(qix_rx_buf[i + 3], &qix_rx_buf[i + 6], plen);
+            i += total;
+        } else {
+            i += 1;   /* invalid cksum: spurious 0x9E */
+        }
+    }
+    if (i > 0) {
+        qix_rx_len -= i;
+        memmove(qix_rx_buf, &qix_rx_buf[i], qix_rx_len);
+    }
+}
