+# LINK_AT=1 links via a response file (@objs.txt) to avoid the Windows command-line
+# length limit (LINK_AT=0 passes all objects inline -> Error 206). The original
+# recipe wrote the response file with $(file ...), but THIS make.exe silently
+# no-ops $(file), leaving a stale objs.txt -> the link picked up the wrong
+# objects (e.g. a Code::Blocks obj/Release build instead of make's objs/). Instead
+# we regenerate it from the objects on disk (here the recipe shell is POSIX, so find/tr
+# work). Since this globs every *.o under $(BUILD_DIR), you MUST `rm -rf $(BUILD_DIR)` when
+# switching build config (the -D defines aren't tracked in the .d files). See BUILD_SYSTEM.md.
 ifeq ($(LINK_AT), 1)
 $(OUT_ELF): $(OBJS)
 	$(info +LINK $@)
 	$(shell $(MKDIR) $(@D))
-	$(file >$(OBJ_FILE), $(OBJS))
+	$(QUITE) find $(BUILD_DIR) -name '*.o' | tr '\n' ' ' > $(OBJ_FILE)
 	$(QUITE) $(LD) -o $(OUT_ELF) @$(OBJ_FILE) $(LFLAGS) $(LIBPATHS) $(LIBS)
 else
 $(OUT_ELF): $(OBJS)
