+     * Static last key so LVGL sees a clean PRESS->RELEASE transition. */
+    static uint32_t s_last = LV_KEY_ENTER;
+    u8 kv = g_badge_adkey_kv;
+    uint32_t lvkey = 0;
+    if (kv == KEY_AD_NUM0) {
+        lvkey = LV_KEY_ENTER;   /* Button 1 = select / back */
+    } else if (kv == KEY_AD_NUM1) {
+        /* On the GATT detail scene Button 2 = retry discovery (there is nothing to navigate there),
+         * everywhere else it stays as the NEXT navigation key. The flag is debounced in the main loop. */
+        extern volatile unsigned char g_scanner_detail_active;
+        extern volatile unsigned char g_scanner_retry_req;
+        if (g_scanner_detail_active) {
+            g_scanner_retry_req = 1;
+        } else {
+            lvkey = LV_KEY_NEXT;    /* Button 2 = navigate */
+        }
+    }
+    if (lvkey) {
+        s_last = lvkey;
+        data->key = lvkey;
+        data->state = LV_INDEV_STATE_PR;
+    } else {
+        data->key = s_last;
+        data->state = LV_INDEV_STATE_REL;
+    }
