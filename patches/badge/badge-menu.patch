+
+#ifdef CONFIG_BADGE_MENU
+/* ---- Badge Scanner: classic BR/EDR inquiry glue -----------------------------------------
+ * The Scanner screen (apps/common/ui/lvgl_v8/lvgl_main.c) lists BOTH nearby BLE advertisers
+ * AND classic BR/EDR devices. The BLE half scans via ble_op_* and gets 0xE2 adv reports;
+ * the classic half runs a BR/EDR inquiry here and feeds every result into the SAME device
+ * table via badge_scanner_add_device(). The inquiry-result callback is abstracted by the
+ * btstack lib (bt_inquiry_result_handle_register); we don't parse raw HCI inquiry events.
+ * Modeled on bt_emitter.c. */
+extern void badge_scanner_add_device(const u8 *addr, const char *name, signed char rssi, u8 type,
+                                     const u8 *adv_data, u8 adv_len, u8 addr_type);
+
+static u8 badge_classic_inquiry_result(char *name, u8 name_len, u8 *addr, u32 dev_class, char rssi)
+{
+    char nbuf[32];
+    if (name && name_len) {
+        u8 n = (name_len < (u8)(sizeof(nbuf) - 1)) ? name_len : (u8)(sizeof(nbuf) - 1);
+        memcpy(nbuf, name, n);
+        nbuf[n] = 0;
+    } else {
+        /* No EIR name in the inquiry response; the MAC still identifies the device. */
+        strcpy(nbuf, "Unknown");
+    }
+    printf("scanner: BR result '%s' rssi=%d class=%06x\n", nbuf, (int)(signed char)rssi, (unsigned)dev_class);
+    badge_scanner_add_device(addr, nbuf, (signed char)rssi, 1 /* SCANNER_TYPE_BR */, NULL, 0, 0);
+    return 0;   /* FALSE: keep searching, never auto-connect */
+}
+
+void badge_classic_inquiry_start(void)
+{
+    if (is_bredr_close()) {
+        /* The classic controller is off (e.g. after using the Mouse). Skip the inquiry; the
+         * scanner still lists BLE devices. Enter Scanner from a clean boot for classic
+         * results. */
+        printf("scanner: classic is closed -> BLE-only (skip inquiry)\n");
+        return;
+    }
+    bt_inquiry_result_handle_register(badge_classic_inquiry_result);
+    /* Enable the emitter/inquiry machinery in the closed btstack lib. Without this the
+     * USER_CTRL_SEARCH_DEVICE command is accepted but no inquiry actually runs (confirmed over
+     * UART: LE scan off, classic open, command issued, and still zero HCI inquiry
+     * activity/results). We set ONLY the enable flag, not g_bt_hdl.emitter_or_receiver / A2DP-
+     * source init, to avoid turning the badge into an audio emitter. */
+    extern void bt_emitter_set_enable_flag(u8 flag);
+    bt_emitter_set_enable_flag(1);
+    u8 inquiry_len = 6;   /* inquiry duration = 6 * 1.28s ~= 7.7s (fits in the ~9s inquiry window) */
+    bt_cmd_prepare(USER_CTRL_SEARCH_DEVICE, 1, &inquiry_len);
+    printf("scanner: classic inquiry started\n");
+}
+
+void badge_classic_inquiry_stop(void)
+{
+    bt_cmd_prepare(USER_CTRL_INQUIRY_CANCEL, 0, NULL);
+    printf("scanner: classic inquiry stopped\n");
+}
