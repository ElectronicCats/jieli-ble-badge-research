+/* ---- Mouse tool: the touchscreen as a BLE trackpad --------------
+ * Touch belongs entirely to LVGL; relative mouse movement is derived from
+ * LVGL's own press events on a full-area trackpad object, so no second reader
+ * fights LVGL for the AXS5106L. mouse_send() is the transport seam — for now
+ * it traces to PA4; the BLE HID report goes there next. */
+static lv_point_t g_mouse_last;
+static int g_mouse_accum;
+
+static void mouse_send(int dx, int dy, int buttons)
+{
+    printf("mouse dx=%d dy=%d btn=%d\n", dx, dy, buttons);   /* PA4 trace */
+    /* Emits a BLE HID input report (no-op until a host has connected/subscribed). */
+    extern void ble_hid_mouse_report(int buttons, int dx, int dy);
+    ble_hid_mouse_report(buttons, dx, dy);
+}
+
+static void mouse_pad_cb(lv_event_t *e)
+{
+    lv_event_code_t code = lv_event_get_code(e);
+    lv_point_t p;
+    lv_indev_get_point(lv_indev_get_act(), &p);
+
+    if (code == LV_EVENT_PRESSED) {
+        g_mouse_last = p;
+        g_mouse_accum = 0;
+    } else if (code == LV_EVENT_PRESSING) {
+        int dx = p.x - g_mouse_last.x;
+        int dy = p.y - g_mouse_last.y;
+        if (dx || dy) {
+            mouse_send(dx, dy, 0);
+            g_mouse_accum += (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
+            g_mouse_last = p;
+        }
+    } else if (code == LV_EVENT_RELEASED) {
+        /* Little net movement => it was a tap => left click; a drag is just movement. */
+        if (g_mouse_accum < 8) {
+            mouse_send(0, 0, 1);
+            mouse_send(0, 0, 0);
+        }
+    }
+}
