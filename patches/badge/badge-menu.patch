+static void badge_menu_build(void)
+{
+    static const char *const items[4] = {
+        "Bluetooth Spoofing", "Bluetooth Mouse", "Bluetooth Scanner", "Settings"
+    };
+    printf("menu: build\n");
+
+    /* Detail screen: built once here, reused for each item. */
+    g_detail_scr = lv_obj_create(NULL);
+    lv_obj_clear_flag(g_detail_scr, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_color(g_detail_scr, lv_color_black(), 0);
