+
+/*
+** QSPI mode: reused from the working 360x360 driver of the 1st badge. This is the
+** hardware CALIBRATION KNOB — if the panel comes up blank/corrupt, try the other
+** SUBMODE / 1T8B variants below (the init table is the panel's own init sequence).
+*/
+/* Controller = Sitronix ST77916 (identified: this init matches the SDK's original ST77916
+ * driver command by command — F0/28 unlock, F0 paging, registers 7C/83/84,
+ * 14-parameter E0/E1 gamma. The ST77916's QSPI interface is SUBMODE1_1T2B, NOT the
+ * SUBMODE2 that badge 1's HTY panel used — the wrong submode clocked the pixels
+ * incorrectly and made the screen flicker/blank. */
+/* JD9855 (panel "lc9855") datasheet §7.1.8.4: QSPI framebuffer streaming uses the
+ * "1-address, 4-lane" write = command 0x32 = JieLi's QSPI_SUBMODE1. SUBMODE2 (0x12 =
+ * 4-address) was wrong — clocks address bits into the pixel data -> burned colors. */
+#define LCD_DRIVE_CONFIG                    QSPI_RGB565_SUBMODE1_1T2B
+
+#include "includes.h"
+#include "ui/ui_api.h"
+
+#define SCR_X       0
+#define SCR_Y       0
+#define SCR_W       LCD_WIDTH
+#define SCR_H       LCD_HEIGHT
+#define LCD_W       LCD_WIDTH
+#define LCD_H       LCD_HEIGHT
+#define LCD_BLOCK_W LCD_WIDTH
+#define LCD_BLOCK_H 16
+#define BUF_NUM     2
+
+#define LCD_FORMAT OUTPUT_FORMAT_RGB565
+
+static const struct dbi_param lcd_qspi_badge2_param;
+
+/*
+** Power-on init sequence — second panel variant (AC707N / BR35).
+** ----------------------------------------------------------------------------
+** Panel init sequence for this variant: 194 blocks (193 cmd + 1 delay).
+**
+** Panel: 360x360 round, RGB565. The controller is NOT any stock SDK lcd_spi driver
+** (the register map differs from st77916/ST77903/GC9B71). Signature:
+**   0xF0/0xF2 0x28 = command-set unlock/page select   0xFF 5A A5 FF = manufacturer unlock
+**   0xE0/0xE1 = 14-parameter gamma   0x36=0xD0 MADCTL   0x3A=0x05 RGB565
+**   0x21 INVON (this glass DOES invert)   0x11 sleep-out -> 120ms -> 0x29 on
+** The table below IS the driver — the model name is irrelevant to bring-up.
+*/
+static const u8 lcd_qspi_badge2_cmd_list_poweron[] ALIGNED(4) = {
+    _BEGIN_, 0xde, 0x00, _END_,
+    _BEGIN_, 0xdf, 0x98, 0x55, _END_,
+    _BEGIN_, 0xb2, 0x2c, _END_,
+    _BEGIN_, 0xb7, 0x01, 0x29, 0x01, 0x51, _END_,
+    _BEGIN_, 0xbb, 0x1b, 0x64, 0xc4, 0x0e, 0x3e, 0xf5, _END_,
