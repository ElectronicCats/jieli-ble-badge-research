+                 u[15], u[14], u[13], u[12], u[11], u[10], u[9], u[8],
+                 u[7], u[6], u[5], u[4], u[3], u[2], u[1], u[0], props);
+    }
+    badge_gatt_append(line);
+    g_badge_gatt_dirty = 1;
+}
+
+/* Called by the real client on connect (st=2) / disconnect (st=4). */
+void badge_gatt_set_state(int st)
+{
+    /* Do not overwrite a completed discovery (3) with a later disconnect(4). */
+    if (st == 4 && g_badge_gatt_state == 3) {
+        return;
+    }
+    g_badge_gatt_state = st;
+    g_badge_gatt_dirty = 1;
+}
+
+/* Starts a central connection to a scanned BLE device; the real client discovers services automatically. */
+void badge_gatt_connect(const u8 *addr, u8 addr_type)
+{
+    extern int badge_client_connect(u8 *addr, u8 addr_type);
+    g_badge_gatt_len = 0;
+    g_badge_gatt_text[0] = 0;
+    g_badge_gatt_last_svc = 0xffff;
+    g_badge_gatt_state = 1;   /* connecting */
+    g_badge_gatt_dirty = 1;
+    badge_client_connect((u8 *)addr, addr_type);
+}
+
+void badge_gatt_disconnect(void)
+{
+    extern void ble_multi_client_disconnect(void);
+    ble_multi_client_disconnect();
+    g_badge_gatt_state = 0;
+    g_badge_gatt_dirty = 0;
+}
+
+/* UI shims left as no-ops: the real client now controls adv-sync/retry. */
+void badge_gatt_on_adv(const u8 *addr, u8 addr_type)
+{
+    (void)addr;
+    (void)addr_type;
+}
+
+u8 badge_gatt_service(u8 may_rearm)
+{
+    (void)may_rearm;
+    return 0;   /* the real client handles retry */
+}
+
+void badge_gatt_connect_timeout(void)
+{
+    if (g_badge_gatt_state == 1) {
+        g_badge_gatt_state = 4;
+        g_badge_gatt_dirty = 1;
+    }
+}
+
+int  badge_gatt_get_state(void) { return g_badge_gatt_state; }
+const char *badge_gatt_get_text(void) { return g_badge_gatt_text; }
+u8   badge_gatt_take_dirty(void) { u8 d = g_badge_gatt_dirty; g_badge_gatt_dirty = 0; return d; }
+const char *badge_gatt_get_diag(void) { return ""; }
+#endif /* CONFIG_BADGE_MENU */
